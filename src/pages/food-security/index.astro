---
// src/pages/food-security/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import StatHighlight from '../../components/StatHighlight.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('food-security')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const carouselSlides = [
  {
    label: 'Slide 1 — The Hook',
    text: `If farmers are dumping vegetables on roads and you are paying high prices at supermarkets — where is the money going?\n\n#StopFoodWastage #AffordableFood #FoodForAll`
  },
  {
    label: 'Slide 2 — The Problem',
    text: `The culprit: SUPPLY CHAIN BLEED.\n\nUp to 30% of fresh produce spoils in transit due to broken cold chains and delays.\n\nYou are literally paying for food that nobody ate.\n\n#ZeroFoodWaste #SaveFoodSaveMoney`
  },
  {
    label: 'Slide 3 — The Mechanism',
    text: `Here is how waste drives your grocery bill up:\n\n🌽 Farmer harvests 100 kg of tomatoes\n🚛 30 kg spoils in transit — no cold storage\n🏪 Retailer marks up the remaining 70 kg to recover losses\n💸 You pay the price for 100 kg, but only 70 kg exists\n\n#FoodRescueIndia #AffordableFood`
  },
  {
    label: 'Slide 4 — The Fix',
    text: `How we fix it:\n\n✅ Decentralised cold-storage hubs at farm gates\n✅ Dynamic pricing: 50–70% markdowns on expiring produce\n✅ Farm-to-table cooperatives cutting out intermediaries\n✅ Mandate surplus food redistribution to NGOs\n\n#ZeroFoodWaste #FoodForAll`
  },
  {
    label: 'Slide 5 — The CTA',
    text: `Food security isn't just about growing more.\nIt's about NOT WASTING what we already harvest.\n\nIndia wastes Rs 92,000 crore worth of food every year.\nThat is enough to feed every undernourished person in the country.\n\nShare this. Demand change.\n📍 parasactivist.in/food-security/\n\n#StopFoodWastage #RespectTheHarvest`
  },
  {
    label: 'Wedding Feast Caption',
    text: `🍛 10–15% of catered event food in India is tossed out.\nMeanwhile, 1 in 7 people struggles to get two square meals a day.\n\nBefore your next wedding, birthday, or corporate party — partner with Robin Hood Army, Feeding India, or No Food Waste.\n\nOne phone call redirects surplus meals to families in need within hours. Save food, save money, feed people.\n\n#StopFoodWastage #FoodRescueIndia #ZeroFoodWaste`
  }
];

const consumerTips = [
  {
    icon: '🧊',
    title: 'First-In, First-Out (FIFO)',
    tip: 'Place newly bought dairy and produce behind older items in the fridge. Older stock gets used first — before it spoils. This single habit eliminates most household food waste.',
    copyText: '💡 FIFO Fridge Hack: Place new groceries BEHIND older ones so you always use the older stock first. Stops 80% of household fridge waste.\n\n#SaveFoodSaveMoney #ZeroFoodWaste'
  },
  {
    icon: '🥕',
    title: 'Buy "Ugly" Produce',
    tip: 'Misshapen, bruised, or oddly-sized vegetables have identical nutritional value. Supermarkets reject 20–40% of farm produce on cosmetic grounds alone. Buying "seconds" lowers farm-gate losses and reduces retail prices for everyone.',
    copyText: '🥕 That ugly tomato? Same taste. Same nutrition. Half the waste.\n\nSupermarkets reject up to 40% of farm produce on looks alone — which is why grocery prices stay high and farmers lose money.\n\nBuy imperfect produce. Save money. Reduce waste.\n\n#StopFoodWastage #AffordableFood'
  },
  {
    icon: '🍲',
    title: 'Batch Cook & Freeze',
    tip: 'Freeze leftover gravies and curries in portions. Blanch and freeze wilting greens before they spoil. Turn stale bread into croutons or breadcrumbs. A full freezer is a food rescue system built into your kitchen.',
    copyText: '❄️ Your freezer is your most underused food-saving tool.\n\n→ Leftover curry? Freeze it in portions.\n→ Wilting spinach? Blanch and freeze.\n→ Stale bread? Croutons or breadcrumbs.\n\nCut your grocery bill by 15–20% just by using what you already bought.\n\n#SaveFoodSaveMoney #ZeroFoodWaste'
  }
];

const policyReforms = [
  {
    icon: '🤝',
    number: '01',
    title: 'Mandate Surplus Redistribution',
    description: 'Commercial kitchens, banquet halls, and large supermarket chains should be legally required to partner with verified food rescue NGOs — rather than disposing of surplus food. Organisations like Robin Hood Army and No Food Waste have already proved the model works at scale.',
    hashtags: ['FoodRescueIndia', 'StopFoodWastage', 'FoodForAll'],
    copyText: '📢 POLICY DEMAND: Mandate that commercial kitchens, banquet halls, and supermarkets partner with food rescue NGOs instead of dumping surplus food.\n\nRobin Hood Army and No Food Waste have already proved this works at scale.\n\nTag your local MLA/MP and demand this become law.\n\n#FoodRescueIndia #StopFoodWastage #FoodForAll\n\nSource: parasactivist.in/food-security/'
  },
  {
    icon: '🏷️',
    number: '02',
    title: 'Dynamic Markdowns on Expiring Food',
    description: 'Demand that grocery chains and quick-commerce apps introduce 50–70% end-of-day discounts on produce nearing expiry — a model standard across Europe (Lidl, Marks & Spencer, Too Good To Go) that dramatically cuts household costs and eliminates retail food waste.',
    hashtags: ['AffordableFood', 'ZeroFoodWaste', 'SaveFoodSaveMoney'],
    copyText: '📢 POLICY DEMAND: Grocery chains and quick-commerce apps should offer 50–70% markdowns on food nearing expiry.\n\nThis is already standard in Europe — it cuts household grocery bills AND eliminates retail food waste.\n\nTag @BigBasket @Blinkit @Swiggy @Zepto and demand end-of-day price drops.\n\n#AffordableFood #ZeroFoodWaste #SaveFoodSaveMoney'
  },
  {
    icon: '🧺',
    number: '03',
    title: 'Community Fridges',
    description: 'Encourage installation of public "pantry fridges" outside restaurants and offices where clean, packed excess food can be collected by anyone — without registration, stigma, or paperwork. Several Indian cities have successful pilots. This needs to scale.',
    hashtags: ['FoodForAll', 'ZeroFoodWaste', 'FoodRescueIndia'],
    copyText: '📢 COMMUNITY ASK: Install public "community fridges" outside restaurants and offices in our city.\n\nAnyone can deposit clean, packed surplus food. Anyone can take what they need — no registration, no stigma.\n\nTag your local restaurant association, RWA, or municipality and ask them to start one.\n\n#FoodForAll #ZeroFoodWaste #FoodRescueIndia'
  }
];
---

<BaseLayout
  title="Food Security"
  description="India is the world's second-largest food producer yet ranks 111th on the Global Hunger Index. 15-30% of perishables rot in transit, driving up grocery bills. This is not a production crisis — it is a distribution and political will crisis."
  ogImage="/og/food-security.png"
  causeColor="food"
>
  <!-- Cause Hero -->
  <section class="cause-hero" aria-label="Food Security overview">
    <div class="container">
      <div class="cause-hero__inner">
        <div class="cause-hero__label">
          <span class="tag tag--food">Food Security</span>
        </div>
        <h1 class="cause-hero__heading">
          India wastes food.<br />
          <span class="cause-hero__accent">India also starves.</span><br />
          These facts coexist.
        </h1>
        <p class="cause-hero__sub">
          The Global Hunger Index 2023 ranks India 111th out of 125 nations. In the same year, the Food Corporation of India held over <strong>61 million metric tonnes</strong> of grain in central storage — nearly three times the buffer norm. Meanwhile, 15–30% of fresh produce rots in transit before reaching consumers. This is not a production problem. It is a system problem — and it is making your grocery bill more expensive.
        </p>
        <div class="cause-hero__actions">
          <a href="/food-security/myths/" class="btn btn-primary" id="food-myths-cta">
            Read Myth vs. Fact
          </a>
          <a href="/food-security/data/" class="btn btn-outline" id="food-data-cta">
            View Data & Statistics
          </a>
        </div>
        <div class="cause-hero__share">
          <ShareButtons title="Food Security - Evidence from Paras Activist" url="https://parasactivist.in/food-security/" />
          <a href="https://www.instagram.com/stopfoodwastagein" class="insta-handle insta-handle--food" target="_blank" rel="noopener noreferrer" aria-label="Follow @stopfoodwastagein on Instagram">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            @stopfoodwastagein
          </a>
        </div>

        <!-- Hashtag strip -->
        <div class="hashtag-strip" aria-label="Campaign hashtags">
          {['StopFoodWastage','ZeroFoodWaste','AffordableFood','FoodForAll','SaveFoodSaveMoney','FoodRescueIndia'].map(tag => (
            <span class="hashtag-strip__chip">#{tag}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Key Statistics -->
  <section class="section--sm" aria-label="Key statistics">
    <div class="container">
      <div class="stats-grid">
        <StatHighlight number="111th" label="India's rank on the Global Hunger Index 2023 (out of 125 nations)" source="Welthungerhilfe / Global Hunger Index 2023" color="food" />
        <StatHighlight number="15–30%" label="of fruits, vegetables & perishables spoil before reaching consumers — driving up grocery prices (MoFPI / ICAR)" source="Ministry of Food Processing Industries & ICAR, 2022" color="food" />
        <StatHighlight number="Rs 92,000 Cr" label="Estimated annual food wastage in India — enough to address chronic undernutrition" source="Indian Council of Agricultural Research, 2022" color="food" />
      </div>
    </div>
  </section>

  <!-- ── Section 1: Supply Chain Bleed ── -->
  <section class="section--sm supply-chain" aria-label="How supply chain waste drives food prices up">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-eyebrow">📦 The Hidden Tax on Your Grocery Bill</span>
        <h2>How Wasted Food Makes Food Expensive</h2>
        <p class="section-sub">
          Food inflation is not just about demand. It is about how much food disappears between the farm and your table.
        </p>
      </div>

      <div class="supply-chain__grid">
        <!-- Left: The Paradox Explainer -->
        <div class="supply-card supply-card--paradox reveal">
          <div class="supply-card__badge">The Paradox</div>
          <h3>World's 2nd largest food producer. 111th on Global Hunger Index.</h3>
          <p>India grows more grain, milk, fruits, and vegetables than almost any country on earth. Yet millions face chronic undernutrition — not because we don't produce enough, but because up to <strong>30% of what we produce never reaches anyone.</strong></p>
          <blockquote class="supply-card__quote">
            "Wasted food creates artificial scarcity. Artificial scarcity drives prices up. High prices make food unaffordable. You pay the cost of the waste."
          </blockquote>
        </div>

        <!-- Right: The Price Flow -->
        <div class="reveal reveal-delay-1">
          <div class="supply-card supply-card--flow">
            <div class="supply-card__badge">How Your Price Gets Inflated</div>
            <div class="price-flow">
              <div class="price-flow__step price-flow__step--farm">
                <span class="price-flow__icon">🌾</span>
                <div>
                  <strong>Farm Gate</strong>
                  <span>100 kg tomatoes harvested</span>
                </div>
              </div>
              <div class="price-flow__arrow" aria-hidden="true">↓</div>
              <div class="price-flow__step price-flow__step--loss">
                <span class="price-flow__icon">🚛</span>
                <div>
                  <strong>Transit Loss</strong>
                  <span>25–30 kg rots — no cold storage</span>
                </div>
              </div>
              <div class="price-flow__arrow" aria-hidden="true">↓</div>
              <div class="price-flow__step price-flow__step--retail">
                <span class="price-flow__icon">🏪</span>
                <div>
                  <strong>Retail Markup</strong>
                  <span>70 kg priced to recover 100 kg costs</span>
                </div>
              </div>
              <div class="price-flow__arrow" aria-hidden="true">↓</div>
              <div class="price-flow__step price-flow__step--consumer">
                <span class="price-flow__icon">💸</span>
                <div>
                  <strong>You Pay</strong>
                  <span>For food that nobody ate</span>
                </div>
              </div>
            </div>
          </div>

          <div class="supply-card supply-card--methane reveal reveal-delay-2">
            <div class="supply-card__badge">The Climate Cost</div>
            <p>Wasted food in municipal dumps decomposes anaerobically, generating <strong>methane</strong> — a greenhouse gas over 25× more potent than CO₂. India's food waste is not just an economic crisis. It is a climate emergency.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Section 2: Social Media Toolkit ── -->
  <section class="section--sm social-toolkit" aria-label="Social media content toolkit for food security">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-eyebrow">📱 Share Toolkit</span>
        <h2>Ready-to-Post Social Media Copy</h2>
        <p class="section-sub">
          Six pre-formatted posts for WhatsApp, Instagram, and Twitter. Copy in one tap. No editing needed.
        </p>
      </div>

      <div class="social-slides">
        {carouselSlides.map((slide, i) => (
          <div class={`social-slide reveal reveal-delay-${(i % 3) + 1}`}>
            <div class="social-slide__header">
              <span class="social-slide__label">{slide.label}</span>
            </div>
            <pre class="social-slide__text">{slide.text}</pre>
            <button
              class="btn btn-outline social-slide__copy"
              id={`food-copy-slide-${i}`}
              data-copy={slide.text}
              type="button"
              aria-label={`Copy ${slide.label} to clipboard`}
            >
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              Copy
            </button>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Section 3: Consumer Action Guide ── -->
  <section class="section--sm consumer-guide" aria-label="Consumer tips to cut grocery bill and reduce food waste">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-eyebrow">🛒 Take Action at Home</span>
        <h2>Cut Your Grocery Bill by 20% — Starting Today</h2>
        <p class="section-sub">
          Individual action and systemic change are not in conflict. Here is what you can do right now — with a shareable tip for each.
        </p>
      </div>

      <div class="consumer-guide__grid">
        {consumerTips.map((tip, i) => (
          <div class={`consumer-card reveal reveal-delay-${i + 1}`}>
            <div class="consumer-card__icon" aria-hidden="true">{tip.icon}</div>
            <h3 class="consumer-card__title">{tip.title}</h3>
            <p class="consumer-card__body">{tip.tip}</p>
            <button
              class="btn btn-outline consumer-card__copy"
              id={`consumer-tip-${i}`}
              data-copy={tip.copyText}
              type="button"
              aria-label={`Copy ${tip.title} tip to clipboard`}
            >
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              Copy & Share Tip
            </button>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Section 4: Policy Reforms ── -->
  <section class="section--sm policy-hub" aria-label="Policy reforms to advocate for food security">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-eyebrow">🏛️ Advocate for Change</span>
        <h2>Three Systemic Reforms — Champion Them</h2>
        <p class="section-sub">
          Consumer tips matter. But the scale of India's food waste requires structural solutions. Here is what to demand from your elected representatives and corporations.
        </p>
      </div>

      <div class="policy-hub__grid">
        {policyReforms.map((policy, i) => (
          <div class={`policy-card reveal reveal-delay-${i + 1}`}>
            <div class="policy-card__header">
              <span class="policy-card__number">{policy.number}</span>
              <span class="policy-card__icon" aria-hidden="true">{policy.icon}</span>
            </div>
            <h3 class="policy-card__title">{policy.title}</h3>
            <p class="policy-card__body">{policy.description}</p>
            <div class="policy-card__hashtags" aria-label="Relevant hashtags">
              {policy.hashtags.map(tag => (
                <span class="hashtag-chip">#{tag}</span>
              ))}
            </div>
            <button
              class="btn btn-outline policy-card__copy"
              id={`policy-copy-${i}`}
              data-copy={policy.copyText}
              type="button"
              aria-label={`Copy ${policy.title} advocacy post`}
            >
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              Copy Advocacy Post
            </button>
          </div>
        ))}
      </div>

      <div class="food-ngos reveal">
        <span class="food-ngos__label">Food Rescue Organisations to Support & Contact</span>
        <div class="food-ngos__list">
          <a href="https://robinhoodarmy.com" target="_blank" rel="noopener noreferrer" class="ngo-chip">🤝 Robin Hood Army</a>
          <a href="https://feedingindia.org" target="_blank" rel="noopener noreferrer" class="ngo-chip">🍱 Feeding India</a>
          <a href="https://nofoodwaste.org" target="_blank" rel="noopener noreferrer" class="ngo-chip">🌱 No Food Waste</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 📅 Seasonal Produce Calendar ── -->
  <section class="section--sm seasonal" aria-label="Seasonal produce calendar for India">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-eyebrow">📅 Buy Smart, Save More</span>
        <h2>India Seasonal Produce Calendar</h2>
        <p class="section-sub">
          Buying in-season costs 40–60% less than out-of-season produce and eliminates cold-chain transit waste. This is your most practical tool against food inflation.
        </p>
      </div>
      <div class="season-grid">
        <div class="season-card season-card--winter reveal reveal-delay-1">
          <div class="season-card__header">
            <span class="season-card__icon">❄️</span>
            <div>
              <h3 class="season-card__title">Winter</h3>
              <span class="season-card__months">October – February</span>
            </div>
          </div>
          <ul class="season-card__list">
            <li>🥕 Carrots, radishes, beetroot</li>
            <li>🌱 Peas, beans, fenugreek</li>
            <li>🥦 Spinach, mustard leaves, cabbage</li>
            <li>🦔 Cauliflower, broccoli</li>
            <li>🍊 Oranges, guava, amla</li>
            <li>🍯 Jaggery, sesame (til)</li>
          </ul>
          <div class="season-card__tip">💡 Peak supply = lowest prices. Stock up on winter vegetables for batch cooking and freezing.</div>
        </div>
        <div class="season-card season-card--summer reveal reveal-delay-2">
          <div class="season-card__header">
            <span class="season-card__icon">☀️</span>
            <div>
              <h3 class="season-card__title">Summer</h3>
              <span class="season-card__months">March – June</span>
            </div>
          </div>
          <ul class="season-card__list">
            <li>🥭 Mangoes (600+ varieties in India)</li>
            <li>🍉 Watermelon, muskmelon</li>
            <li>🍆 Bottle gourd, ridge gourd, tinda</li>
            <li>🥑 Raw jackfruit, drumstick (moringa)</li>
            <li>🍅 Tomatoes (peak, cheapest season)</li>
            <li>🧅 Cucumber, ash gourd</li>
          </ul>
          <div class="season-card__tip">💡 Make mango pulp and freeze it. Buy tomatoes in bulk and sun-dry them to avoid buying at off-season prices.</div>
        </div>
        <div class="season-card season-card--monsoon reveal reveal-delay-3">
          <div class="season-card__header">
            <span class="season-card__icon">🌧️</span>
            <div>
              <h3 class="season-card__title">Monsoon</h3>
              <span class="season-card__months">July – September</span>
            </div>
          </div>
          <ul class="season-card__list">
            <li>🌽 Sweet corn (peak season)</li>
            <li>🫐 Bitter gourd, snake gourd</li>
            <li>🍏 Jamun, litchi</li>
            <li>🌿 Colocasia (arbi), yam</li>
            <li>🥑 Ripe jackfruit</li>
            <li>🍅 Brinjal, lady's finger</li>
          </ul>
          <div class="season-card__tip">💡 Avoid leafy greens in peak monsoon (contamination risk is higher). Focus on gourds and root vegetables.</div>
        </div>
      </div>
      <div class="seasonal-share reveal">
        <button class="btn btn-outline" id="copy-seasonal" data-copy="📅 INDIA SEASONAL PRODUCE CALENDAR — Buy in-season = 40-60% cheaper + zero transit waste\n\n❄️ WINTER (Oct–Feb): Carrots, peas, spinach, cauliflower, oranges, guava\n☀️ SUMMER (Mar–Jun): Mangoes, watermelon, bottle gourd, tomatoes (cheapest), drumstick\n🌧️ MONSOON (Jul–Sep): Corn, bitter gourd, jamun, jackfruit, brinjal\n\nPro tip: Buy at peak, batch cook and freeze. Your grocery bill drops 15-20% immediately.\n\n#SaveFoodSaveMoney #AffordableFood #ZeroFoodWaste #StopFoodWastage" type="button" aria-label="Copy seasonal calendar">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          Copy & Share Calendar
        </button>
      </div>
    </div>
  </section>

  <!-- ── 🏦 PDS Gap Explainer ── -->
  <section class="section--sm pds-section" aria-label="PDS and NFSA rights explainer">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-eyebrow">🏦 Know Your Entitlements</span>
        <h2>The PDS Gap — Who Falls Through the Net</h2>
        <p class="section-sub">
          The National Food Security Act (NFSA) 2013 covers 81 crore people. But the gap between who is entitled and who actually receives is enormous.
        </p>
      </div>
      <div class="pds-grid">
        <div class="pds-card pds-card--covered reveal reveal-delay-1">
          <div class="pds-card__badge">✔️ Covered</div>
          <h3>Who NFSA Covers</h3>
          <ul>
            <li>~81 crore people (67% of India's population)</li>
            <li>5 kg grain/person/month at subsidised rates</li>
            <li>Antodaya Anna Yojana (AAY) households: 35 kg/month</li>
            <li>Access via state-issued ration card (NPHH / PHH)</li>
          </ul>
        </div>
        <div class="pds-card pds-card--excluded reveal reveal-delay-2">
          <div class="pds-card__badge">❌ Falls Through</div>
          <h3>Who Gets Excluded</h3>
          <ul>
            <li>Migrant workers without a local ration card</li>
            <li>Families rejected due to Aadhaar biometric mismatch</li>
            <li>Households in states that update beneficiary lists infrequently</li>
            <li>Homeless individuals without address proof</li>
            <li>Newly married women / students away from home state</li>
          </ul>
        </div>
        <div class="pds-card pds-card--action reveal reveal-delay-3">
          <div class="pds-card__badge">📢 Take Action</div>
          <h3>How to Claim / Escalate</h3>
          <ul>
            <li><strong>Apply for ration card:</strong> Your State's Food & Civil Supplies portal or <a href="https://mera.nic.in" target="_blank" rel="noopener noreferrer">mera.nic.in</a></li>
            <li><strong>ONORC portability:</strong> Use your ration card in any state via One Nation One Ration Card</li>
            <li><strong>Denied / excluded?</strong> File grievance at <a href="https://pgportal.gov.in" target="_blank" rel="noopener noreferrer">pgportal.gov.in</a> under Ministry of Consumer Affairs</li>
