---
// src/pages/food-security/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import StatHighlight from '../../components/StatHighlight.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('food-security')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout
  title="Food Security"
  description="India is the world's second-largest food producer yet ranks 111th on the Global Hunger Index. This is not a production crisis - it is a distribution and political will crisis. Evidence-based analysis."
  ogImage="/og/food-security.png"
  causeColor="food"
>
  <!-- Cause Hero -->
  <section class="cause-hero" aria-label="Food Security overview">
    <div class="container">
      <div class="cause-hero__inner">
        <div class="cause-hero__label">
          <span class="tag tag--food">Food Food Security</span>
        </div>
        <h1 class="cause-hero__heading">
          India wastes food.<br />
          <span class="cause-hero__accent">India also starves.</span><br />
          These facts coexist.
        </h1>
        <p class="cause-hero__sub">
          The Global Hunger Index 2023 ranks India 111th out of 125 nations. In the same year, the Food Corporation of India held over <strong>61 million metric tonnes</strong> of grain in central storage - nearly three times the buffer norm. This is not a production problem. It is a system problem.
        </p>
        <div class="cause-hero__actions">
          <a href="/food-security/myths/" class="btn btn-primary" id="food-myths-cta">
            Read Myth vs. Fact
          </a>
          <a href="/food-security/data/" class="btn btn-outline" id="food-data-cta">
            View Data & Statistics
          </a>
        </div>
        <div class="cause-hero__share">
          <ShareButtons title="Food Security - Evidence from Paras Activist" url="https://parasactivist.in/food-security/" />
        </div>
      </div>
    </div>
  </section>

  <!-- Key Statistics -->
  <section class="section--sm" aria-label="Key statistics">
    <div class="container">
      <div class="stats-grid">
        <StatHighlight number="111th" label="India's rank on the Global Hunger Index 2023 (out of 125 nations)" source="Welthungerhilfe / Global Hunger Index 2023" color="food" />
        <StatHighlight number="Rs 92,000 Cr" label="Estimated annual food wastage in India (ICAR 2022)" source="Indian Council of Agricultural Research, 2022" color="food" />
        <StatHighlight number="61 MT" label="Grain held in FCI central storage in 2022 - nearly 3x the buffer norm" source="Food Corporation of India Annual Report 2022-23" color="food" />
      </div>
    </div>
  </section>

  <!-- Articles -->
  {articles.length > 0 && (
    <section class="section--sm" aria-label="Articles on food security">
      <div class="container">
        <h2>Articles & Analysis</h2>
        <div class="article-list">
          {articles.map(article => (
            <a href={`/food-security/${article.id}/`} class="article-card">
              <div class="article-card__date">
                <time datetime={article.data.publishDate.toISOString()}>
                  {article.data.publishDate.toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
              </div>
              <h3 class="article-card__title">{article.data.title}</h3>
              <p class="article-card__description">{article.data.description}</p>
              <span class="article-card__read">Read -></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Quick Navigation -->
  <section class="section--sm cause-nav" aria-label="Explore more">
    <div class="container">
      <h2>Explore Food Security</h2>
      <div class="cause-nav__grid">
        <a href="/food-security/myths/" class="cause-nav__card" id="nav-food-myths">
          <span class="cause-nav__icon" aria-hidden="true">Media vs Yes</span>
          <h3>Myth vs. Fact</h3>
          <p>Counter the most common misinformation about India's hunger crisis with verified data.</p>
        </a>
        <a href="/food-security/data/" class="cause-nav__card" id="nav-food-data">
          <span class="cause-nav__icon" aria-hidden="true">Data</span>
          <h3>Data & Statistics</h3>
          <p>Government reports, GHI rankings, FCI data, and ICAR estimates - all cited and sourced.</p>
        </a>
        <a href="/share-toolkit" class="cause-nav__card" id="nav-food-share">
          <span class="cause-nav__icon" aria-hidden="true">Share</span>
          <h3>Share Toolkit</h3>
          <p>WhatsApp and Telegram-ready image cards for every key fact on food security.</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cause-hero {
    padding-block: var(--space-16) var(--space-12);
    position: relative;
    overflow: hidden;
  }

  .cause-hero::before {
    content: '';
    position: absolute;
    top: 0; right: 0;
    width: 40vw; height: 40vw;
    background: radial-gradient(circle, var(--clr-food-bg) 0%, transparent 60%);
    pointer-events: none;
  }

  .cause-hero__inner { position: relative; z-index: 1; max-width: 720px; }
  .cause-hero__label { margin-bottom: var(--space-5); }

  .cause-hero__heading {
    margin-bottom: var(--space-5);
    font-size: clamp(2rem, 5vw, 3.25rem);
  }

  .cause-hero__accent { color: var(--clr-food); }

  .cause-hero__sub {
    color: var(--clr-text-muted);
    font-size: 1.0625rem;
    max-width: 60ch;
    margin-bottom: var(--space-8);
    line-height: 1.7;
  }

  .cause-hero__actions { display: flex; gap: var(--space-4); flex-wrap: wrap; margin-bottom: var(--space-8); }
  .cause-hero__share { display: flex; align-items: center; }

  .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }
  @media (max-width: 768px) { .stats-grid { grid-template-columns: 1fr; } }

  .article-list { display: flex; flex-direction: column; gap: var(--space-4); margin-top: var(--space-6); }

  .article-card {
    display: block;
    background: var(--clr-bg-surface);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    text-decoration: none;
    transition: all var(--duration-normal) var(--ease-out);
  }
  .article-card:hover { border-color: var(--clr-food); transform: translateX(4px); }

  .article-card__date { font-size: 0.8rem; color: var(--clr-text-subtle); margin-bottom: var(--space-2); }
  .article-card__title { font-size: 1.125rem; font-weight: 700; margin-bottom: var(--space-2); color: var(--clr-text); }
  .article-card__description { font-size: 0.9rem; color: var(--clr-text-muted); margin-bottom: var(--space-3); }
  .article-card__read { font-size: 0.85rem; font-weight: 600; color: var(--clr-food); }

  .cause-nav h2 { margin-bottom: var(--space-6); }
  .cause-nav__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }
  @media (max-width: 768px) { .cause-nav__grid { grid-template-columns: 1fr; } }

  .cause-nav__card {
    display: block;
    background: var(--clr-bg-surface);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    text-decoration: none;
    transition: all var(--duration-normal) var(--ease-out);
  }
  .cause-nav__card:hover { border-color: var(--clr-food); transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .cause-nav__icon { font-size: 1.5rem; display: block; margin-bottom: var(--space-3); }
  .cause-nav__card h3 { font-size: 1rem; margin-bottom: var(--space-2); color: var(--clr-text); }
  .cause-nav__card p { font-size: 0.875rem; color: var(--clr-text-muted); margin: 0; line-height: 1.5; }
</style>


