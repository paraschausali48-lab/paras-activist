---
// src/pages/404.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found"
  description="This page doesn't exist. Return to the Paras Activist homepage."
  noIndex={true}
>
  <div class="error-page">
    <div class="container">
      <div class="error-inner">
        <div class="error-code" aria-hidden="true">404</div>
        <h1>Page Not Found</h1>
        <p>This page doesn't exist or has been moved. Return to one of our cause pages:</p>
        <div class="error-links">
          <a href="/" class="btn btn-primary" id="error-home"><- Go Home</a>
          <a href="/food-security/" class="btn btn-outline" id="error-food">Food Food Security</a>
          <a href="/footpath/" class="btn btn-outline" id="error-foot">Footpath Footpath Movement</a>
          <a href="/intersectional-justice/" class="btn btn-outline" id="error-just">Justice Intersectional Justice</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .error-page { padding-block: var(--space-20); min-height: 60vh; display: flex; align-items: center; }
  .error-inner { max-width: 560px; }
  .error-code {
    font-size: clamp(5rem, 15vw, 9rem);
    font-weight: 900;
    line-height: 1;
    color: var(--clr-border);
    letter-spacing: -0.05em;
    margin-bottom: var(--space-4);
  }
  .error-inner h1 { margin-bottom: var(--space-4); }
  .error-inner p { color: var(--clr-text-muted); margin-bottom: var(--space-8); }
  .error-links { display: flex; flex-wrap: wrap; gap: var(--space-3); }
</style>

