---
// src/pages/sources.astro — Master bibliography
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Master Bibliography"
  description="Every source cited across all three causes on Paras Activist — Food Security, Footpath Movement, and Intersectional Justice. All government reports, academic papers, and NGO data."
  ogImage="/og/sources.png"
>
  <div class="sources-page">
    <div class="container">
      <header class="sources-header">
        <h1>Master Bibliography</h1>
        <p class="sources-header__sub">
          Every claim on this site traces back to one of these sources.
          Sources are colour-coded by type: 🟢 Government/Official, 🔵 Academic/Peer-reviewed, 🟡 NGO/Independent, 🔴 Media (lowest weight, used sparingly).
        </p>
      </header>

      <!-- Food Security Sources -->
      <section class="bib-section" aria-labelledby="food-sources">
        <h2 id="food-sources">
          <span class="tag tag--food">🌾 Food Security</span>
        </h2>
        <ol class="bib-list">
          <li class="bib-item">
            <span class="bib-type" aria-label="Source type: Government">🟢</span>
            <div>
              <p class="bib-citation"><strong>Global Hunger Index 2023.</strong> Welthungerhilfe & Concern Worldwide.</p>
              <p class="bib-url"><a href="https://www.globalhungerindex.org/india.html" target="_blank" rel="noopener noreferrer">globalhungerindex.org/india.html</a></p>
            </div>
          </li>
          <li class="bib-item">
            <span class="bib-type" aria-label="Source type: Government">🟢</span>
            <div>
              <p class="bib-citation"><strong>Food Corporation of India Annual Report 2022–23.</strong> Government of India, Ministry of Consumer Affairs, Food & Public Distribution.</p>
              <p class="bib-url"><a href="https://fci.gov.in" target="_blank" rel="noopener noreferrer">fci.gov.in</a></p>
            </div>
          </li>
          <li class="bib-item">
            <span class="bib-type" aria-label="Source type: Government Research">🟢</span>
            <div>
              <p class="bib-citation"><strong>Indian Council of Agricultural Research (ICAR). Report on Food Wastage in India.</strong> 2022. New Delhi: ICAR.</p>
              <p class="bib-url"><a href="https://icar.org.in" target="_blank" rel="noopener noreferrer">icar.org.in</a></p>
            </div>
          </li>
          <li class="bib-item">
            <span class="bib-type" aria-label="Source type: UN Agency">🟢</span>
            <div>
              <p class="bib-citation"><strong>Food and Agriculture Organisation of the United Nations (FAO). Food Wastage Footprint: Impacts on Natural Resources.</strong> Rome: FAO, 2013. Updated datasets available at:</p>
              <p class="bib-url"><a href="https://www.fao.org/food-loss-and-food-waste/flw-data/en" target="_blank" rel="noopener noreferrer">fao.org/food-loss-and-food-waste</a></p>
            </div>
          </li>
          <li class="bib-item">
            <span class="bib-type" aria-label="Source type: Government">🟢</span>
            <div>
              <p class="bib-citation"><strong>National Food Security Act, 2013.</strong> Ministry of Consumer Affairs, Food and Public Distribution, Government of India.</p>
              <p class="bib-url"><a href="https://dfpd.gov.in/nfsa.htm" target="_blank" rel="noopener noreferrer">dfpd.gov.in/nfsa.htm</a></p>
            </div>
          </li>
          <li class="bib-item">
            <span class="bib-type" aria-label="Source type: UN">🟢</span>
            <div>
              <p class="bib-citation"><strong>FAO, IFAD, UNICEF, WFP and WHO. The State of Food Security and Nutrition in the World 2024.</strong> Rome: FAO.</p>
              <p class="bib-url"><a href="https://www.fao.org/publications/sofi" target="_blank" rel="noopener noreferrer">fao.org/publications/sofi</a></p>
            </div>
          </li>
          <li class="bib-item">
            <span class="bib-type" aria-label="Source type: Academic">🔵</span>
            <div>
              <p class="bib-citation"><strong>Swaminathan, Madhura.</strong> <em>Weakening Welfare: The Public Distribution of Food in India.</em> New Delhi: LeftWord Books, 2000. ISBN: 978-8187496014.</p>
            </div>
          </li>
          <li class="bib-item">
            <span class="bib-type" aria-label="Source type: Academic">🔵</span>
            <div>
              <p class="bib-citation"><strong>Drèze, Jean & Sen, Amartya.</strong> <em>An Uncertain Glory: India and its Contradictions.</em> Princeton: Princeton University Press, 2013. ISBN: 978-0691160795.</p>
            </div>
          </li>
        </ol>
      </section>

      <hr />

      <!-- Footpath Sources -->
      <section class="bib-section" aria-labelledby="foot-sources">
        <h2 id="foot-sources">
          <span class="tag tag--foot">🚶 Footpath Movement</span>
        </h2>
        <ol class="bib-list">
          <li class="bib-item">
            <span class="bib-type" aria-label="Source type: Government">🟢</span>
            <div>
              <p class="bib-citation"><strong>Ministry of Road Transport and Highways (MoRTH). Road Accidents in India 2022.</strong> New Delhi: Government of India.</p>
              <p class="bib-url"><a href="https://morth.nic.in" target="_blank" rel="noopener noreferrer">morth.nic.in</a></p>
            </div>
          </li>
          <li class="bib-item">
            <span class="bib-type" aria-label="Source type: NGO">🟡</span>
            <div>
              <p class="bib-citation"><strong>Praja Foundation. Mumbai Footpath Audit 2022.</strong> Mumbai: Praja Foundation.</p>
              <p class="bib-url"><a href="https://praja.org" target="_blank" rel="noopener noreferrer">praja.org</a></p>
            </div>
          </li>
          <li class="bib-item">
            <span class="bib-type" aria-label="Source type: International">🟢</span>
            <div>
              <p class="bib-citation"><strong>World Bank. The High Toll of Traffic Injuries: Unacceptable and Preventable.</strong> Washington DC: World Bank, 2019.</p>
              <p class="bib-url"><a href="https://www.worldbank.org/en/topic/transport/publication/the-high-toll-of-traffic-injuries-unacceptable-and-preventable" target="_blank" rel="noopener noreferrer">worldbank.org</a></p>
            </div>
          </li>
          <li class="bib-item">
            <span class="bib-type" aria-label="Source type: NGO/Policy">🟡</span>
            <div>
              <p class="bib-citation"><strong>WRI India. Cities for Walking and Cycling in India.</strong> New Delhi: World Resources Institute India.</p>
              <p class="bib-url"><a href="https://www.wri.org/india" target="_blank" rel="noopener noreferrer">wri.org/india</a></p>
            </div>
          </li>
          <li class="bib-item">
            <span class="bib-type" aria-label="Source type: Policy Research">🟡</span>
            <div>
              <p class="bib-citation"><strong>Institute for Transportation & Development Policy (ITDP). The India Cycling and Walking Report.</strong> New York/New Delhi: ITDP.</p>
              <p class="bib-url"><a href="https://itdp.org" target="_blank" rel="noopener noreferrer">itdp.org</a></p>
            </div>
          </li>
        </ol>
      </section>

      <hr />

      <!-- Intersectional Justice Sources -->
      <section class="bib-section" aria-labelledby="just-sources">
        <h2 id="just-sources">
          <span class="tag tag--just">⚖️ Intersectional Justice</span>
        </h2>
        <ol class="bib-list">
          <li class="bib-item">
            <span class="bib-type">🟢</span>
            <div>
              <p class="bib-citation"><strong>National Crime Records Bureau (NCRB). Crime in India 2021.</strong> New Delhi: Ministry of Home Affairs, Government of India.</p>
              <p class="bib-url"><a href="https://ncrb.gov.in" target="_blank" rel="noopener noreferrer">ncrb.gov.in</a></p>
            </div>
          </li>
          <li class="bib-item">
            <span class="bib-type">🟢</span>
            <div>
              <p class="bib-citation"><strong>Supreme Court of India. National Legal Services Authority (NALSA) v. Union of India & Others.</strong> Writ Petition (Civil) No. 400 of 2012. Judgment dated 15 April 2014.</p>
              <p class="bib-url"><a href="https://main.sci.gov.in" target="_blank" rel="noopener noreferrer">main.sci.gov.in</a></p>
            </div>
          </li>
          <li class="bib-item">
            <span class="bib-type">🟢</span>
            <div>
              <p class="bib-citation"><strong>Supreme Court of India. Navtej Singh Johar & Ors. v. Union of India.</strong> Writ Petition (Criminal) No. 76 of 2016. Judgment dated 6 September 2018. (Partial striking down of Section 377 IPC.)</p>
              <p class="bib-url"><a href="https://main.sci.gov.in" target="_blank" rel="noopener noreferrer">main.sci.gov.in</a></p>
            </div>
          </li>
          <li class="bib-item">
            <span class="bib-type">🟡</span>
            <div>
              <p class="bib-citation"><strong>Oxfam India. India Inequality Report 2022: Digital Divide.</strong> New Delhi: Oxfam India.</p>
              <p class="bib-url"><a href="https://oxfamindia.org" target="_blank" rel="noopener noreferrer">oxfamindia.org</a></p>
            </div>
          </li>
          <li class="bib-item">
            <span class="bib-type">🔵</span>
            <div>
              <p class="bib-citation"><strong>Thorat, Sukhadeo & Attewell, Paul.</strong> "The Legacy of Social Exclusion: A Correspondence Study of Job Discrimination in India." <em>Economic & Political Weekly</em> 42, no. 41 (2007): 4141–4145.</p>
            </div>
          </li>
          <li class="bib-item">
            <span class="bib-type">🔵</span>
            <div>
              <p class="bib-citation"><strong>Gopi Shankar Madurai.</strong> <em>Itihas mein Tritiya Prakriti.</em> [Historical documentation of gender non-conforming communities in India.]</p>
            </div>
          </li>
          <li class="bib-item">
            <span class="bib-type">🔵</span>
            <div>
              <p class="bib-citation"><strong>Jhala, Angma.</strong> <em>Royal Patronage, Power and Aesthetics in Princely India.</em> London: Pickering & Chatto, 2011. ISBN: 978-1848930254.</p>
            </div>
          </li>
          <li class="bib-item">
            <span class="bib-type">🔵</span>
            <div>
              <p class="bib-citation"><strong>Adams, Carol J.</strong> <em>The Sexual Politics of Meat: A Feminist-Vegetarian Critical Theory.</em> New York: Continuum, 1990. ISBN: 978-0826474773.</p>
            </div>
          </li>
          <li class="bib-item">
            <span class="bib-type">🔵</span>
            <div>
              <p class="bib-citation"><strong>Flynn, Clifton P.</strong> "Examining the Link Between Animal Abuse and Human Violence: The Cruelty Connection." <em>Crime, Law and Social Change</em> 55 (2011): 453–468.</p>
            </div>
          </li>
        </ol>
      </section>

    </div>
  </div>
</BaseLayout>

<style>
  .sources-page { padding-block: var(--space-8) var(--space-20); }

  .sources-header { margin-bottom: var(--space-12); max-width: 720px; }
  .sources-header h1 { margin-bottom: var(--space-4); }
  .sources-header__sub { color: var(--clr-text-muted); font-size: 1rem; line-height: 1.7; margin: 0; }

  .bib-section { margin-bottom: var(--space-12); }
  .bib-section h2 { margin-bottom: var(--space-8); }

  .bib-list { list-style: decimal; padding-left: var(--space-6); display: flex; flex-direction: column; gap: var(--space-6); }

  .bib-item {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: var(--space-3);
    align-items: start;
  }

  .bib-type { font-size: 1rem; padding-top: 2px; }

  .bib-citation { font-size: 0.9rem; color: var(--clr-text); margin: 0 0 var(--space-1) 0; line-height: 1.6; }
  .bib-citation strong { font-weight: 700; }

  .bib-url { font-size: 0.8rem; margin: 0; }
  .bib-url a { color: var(--clr-accent); word-break: break-all; text-decoration: underline; text-underline-offset: 3px; }
</style>
