---
// src/pages/footpath/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import StatHighlight from '../../components/StatHighlight.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('footpath')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout
  title="The Footpath Movement"
  description="Pedestrians are India's single largest road accident victim group. Over 60% of Mumbai footpaths are broken or encroached. Safe walking infrastructure is not a luxury — it is a public health and poverty alleviation imperative."
  ogImage="/og/footpath.png"
>
  <section class="cause-hero" aria-label="Footpath Movement overview">
    <div class="container">
      <div class="cause-hero__inner">
        <div class="cause-hero__label">
          <span class="tag tag--foot">🚶 Footpath Movement</span>
        </div>
        <h1 class="cause-hero__heading">
          Pedestrians are dying<br />
          <span class="cause-hero__accent">on roads they were forced onto.</span>
        </h1>
        <p class="cause-hero__sub">
          In 2022, pedestrians accounted for <strong>17% of all road accident deaths</strong> in India — the single largest victim group. They are not choosing the road. Functional, unobstructed footpaths are the exception. We are demanding they become the rule.
        </p>
        <div class="cause-hero__actions">
          <a href="/footpath/myths/" class="btn btn-primary" id="foot-myths-cta">Read Myth vs. Fact</a>
          <a href="/footpath/data/" class="btn btn-outline" id="foot-data-cta">View Data & Statistics</a>
        </div>
        <div class="cause-hero__share">
          <ShareButtons title="The Footpath Movement — Paras Activist" url="https://parasactivist.in/footpath/" />
        </div>
      </div>
    </div>
  </section>

  <section class="section--sm" aria-label="Key statistics">
    <div class="container">
      <div class="stats-grid stagger">
        <StatHighlight number="17%" label="of all Indian road accident deaths are pedestrians — the largest single group (MoRTH 2022)" source="Ministry of Road Transport & Highways, 2022" color="foot" />
        <StatHighlight number="60%+" label="of Mumbai footpaths broken, encroached, or absent (Praja Foundation, 2022)" source="Praja Foundation Mumbai Footpath Audit, 2022" color="foot" />
        <StatHighlight number="3–5% GDP" label="Annual cost of road accidents to India's economy (World Bank)" source="World Bank, The High Toll of Traffic Injuries, 2019" color="foot" />
      </div>
    </div>
  </section>

  {articles.length > 0 && (
    <section class="section--sm" aria-label="Footpath articles">
      <div class="container">
        <h2>Articles & Analysis</h2>
        <div class="article-list">
          {articles.map(article => (
            <a href={`/footpath/${article.id}/`} class="article-card">
              <div class="article-card__date">
                <time datetime={article.data.publishDate.toISOString()}>
                  {article.data.publishDate.toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
              </div>
              <h3 class="article-card__title">{article.data.title}</h3>
              <p class="article-card__description">{article.data.description}</p>
              <span class="article-card__read">Read →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section--sm cause-nav" aria-label="Explore footpath">
    <div class="container">
      <h2>Explore the Footpath Movement</h2>
      <div class="cause-nav__grid">
        <a href="/footpath/myths/" class="cause-nav__card" id="nav-foot-myths">
          <span class="cause-nav__icon" aria-hidden="true">🔴 vs ✅</span>
          <h3>Myth vs. Fact</h3>
          <p>Counter common excuses for why Indian cities fail their pedestrians.</p>
        </a>
        <a href="/footpath/data/" class="cause-nav__card" id="nav-foot-data">
          <span class="cause-nav__icon" aria-hidden="true">📊</span>
          <h3>Data & Statistics</h3>
          <p>MoRTH accident data, Praja audits, World Bank economic costs — all cited.</p>
        </a>
        <a href="/share-toolkit" class="cause-nav__card" id="nav-foot-share">
          <span class="cause-nav__icon" aria-hidden="true">📲</span>
          <h3>Share Toolkit</h3>
          <p>WhatsApp-ready cards with footpath facts for your local community.</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cause-hero {
    padding-block: var(--space-16) var(--space-12);
    position: relative; overflow: hidden;
  }
  .cause-hero::before {
    content: '';
    position: absolute; top: 0; right: 0;
    width: 40vw; height: 40vw;
    background: radial-gradient(circle, var(--clr-foot-bg) 0%, transparent 60%);
    pointer-events: none;
  }
  .cause-hero__inner { position: relative; z-index: 1; max-width: 720px; }
  .cause-hero__label { margin-bottom: var(--space-5); }
  .cause-hero__heading { margin-bottom: var(--space-5); font-size: clamp(2rem, 5vw, 3.25rem); }
  .cause-hero__accent { color: var(--clr-foot); }
  .cause-hero__sub { color: var(--clr-text-muted); font-size: 1.0625rem; max-width: 60ch; margin-bottom: var(--space-8); line-height: 1.7; }
  .cause-hero__actions { display: flex; gap: var(--space-4); flex-wrap: wrap; margin-bottom: var(--space-8); }

  .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }
  @media (max-width: 768px) { .stats-grid { grid-template-columns: 1fr; } }

  .article-list { display: flex; flex-direction: column; gap: var(--space-4); margin-top: var(--space-6); }
  .article-card {
    display: block; background: var(--clr-bg-surface); border: 1px solid var(--clr-border);
    border-radius: var(--radius-lg); padding: var(--space-6); text-decoration: none;
    transition: all var(--duration-normal) var(--ease-out);
  }
  .article-card:hover { border-color: var(--clr-foot); transform: translateX(4px); }
  .article-card__date { font-size: 0.8rem; color: var(--clr-text-subtle); margin-bottom: var(--space-2); }
  .article-card__title { font-size: 1.125rem; font-weight: 700; margin-bottom: var(--space-2); color: var(--clr-text); }
  .article-card__description { font-size: 0.9rem; color: var(--clr-text-muted); margin-bottom: var(--space-3); }
  .article-card__read { font-size: 0.85rem; font-weight: 600; color: var(--clr-foot); }

  .cause-nav h2 { margin-bottom: var(--space-6); }
  .cause-nav__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }
  @media (max-width: 768px) { .cause-nav__grid { grid-template-columns: 1fr; } }
  .cause-nav__card {
    display: block; background: var(--clr-bg-surface); border: 1px solid var(--clr-border);
    border-radius: var(--radius-lg); padding: var(--space-6); text-decoration: none;
    transition: all var(--duration-normal) var(--ease-out);
  }
  .cause-nav__card:hover { border-color: var(--clr-foot); transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .cause-nav__icon { font-size: 1.5rem; display: block; margin-bottom: var(--space-3); }
  .cause-nav__card h3 { font-size: 1rem; margin-bottom: var(--space-2); color: var(--clr-text); }
  .cause-nav__card p { font-size: 0.875rem; color: var(--clr-text-muted); margin: 0; line-height: 1.5; }
</style>
