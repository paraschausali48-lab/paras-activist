---
// src/pages/intersectional-justice/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import StatHighlight from '../../components/StatHighlight.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('intersectional-justice')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const helplines = [
  { number: '112', label: 'National Emergency', icon: '🚨', color: 'danger' },
  { number: '7827170170', label: 'NCW — Women Helpline', icon: '🚺', color: 'women' },
  { number: '1091', label: 'Women in Distress', icon: '🆘', color: 'women' },
  { number: '181', label: 'Domestic Violence', icon: '🏠', color: 'women' },
  { number: '14566', label: 'Trans Community Helpline', icon: '🏳️‍⚧️', color: 'trans' },
  { number: '1093', label: 'Delhi North-East Helpline', icon: '🌏', color: 'region' },
];

const verticals = [
  {
    id: 'women',
    icon: '🚺',
    title: "Women's Rights & Safety",
    subtitle: 'Bodily Autonomy & Legal Safeguards',
    laws: [
      { ref: 'Article 15(3)', desc: 'Empowers the State to make special affirmative provisions for women.' },
      { ref: 'POSH Act, 2013', desc: 'Mandates Internal Complaints Committees (ICC) in all workplaces with 10+ employees. Sexual harassment at work is a cognizable offence.' },
      { ref: 'PWDVA, 2005', desc: 'Protection of Women from Domestic Violence Act. Grants emergency residence orders, protection orders, and monetary relief — even without a criminal case.' },
      { ref: 'Zero FIR', desc: 'By law, no police station can refuse to register a cognizable offence because the crime occurred outside its jurisdiction. Any station must accept the complaint.' },
    ],
    helplines: ['112 — National Emergency', '7827170170 — NCW', '1091 — Women Helpline', '181 — Domestic Abuse'],
    color: 'just',
  },
  {
    id: 'trans',
    icon: '🏳️‍⚧️',
    title: 'Transgender & Queer Justice',
    subtitle: 'Identity, Dignity & Legal Recognition',
    laws: [
      { ref: 'NALSA v. Union of India (2014)', desc: 'Supreme Court affirmed transgender persons as a "Third Gender" with constitutional protection under Articles 14 and 21. Self-identified gender identity is legally recognised.' },
      { ref: 'Navtej Singh Johar (2018)', desc: 'Supreme Court decriminalised consensual queer relationships, partially striking down Section 377 — a British colonial law imposed in 1861.' },
      { ref: 'Trans Persons Act, 2019', desc: 'Prohibits discrimination in employment, education, healthcare, and public facilities. Establishes the National Portal for Gender Certificates at transgender.dosje.gov.in.' },
    ],
    helplines: ['14566 — Trans Community Tele-Counselling & Grievance'],
    resource: { label: 'Apply for Gender Certificate', href: 'https://transgender.dosje.gov.in' },
    color: 'just',
  },
  {
    id: 'caste',
    icon: '✊',
    title: 'Caste Annihilation & Civil Rights',
    subtitle: 'Ending Untouchability & Structural Discrimination',
    laws: [
      { ref: 'Article 17', desc: '"Untouchability" is abolished and its practice in any form is forbidden. Enforcement of any disability arising out of untouchability is an offence punishable in accordance with law.' },
      { ref: 'Article 15(2)', desc: 'Prohibits restriction of access to public shops, restaurants, hotels, wells, tanks, bathing ghats, and roads based on caste, religion, race, sex or place of birth.' },
      { ref: 'SC/ST Atrocities Act, 1989 (Amended 2015, 2018)', desc: 'Provides severe penal consequences for caste-based abuse, institutional boycotts, denial of customary rights, and forced labour. Mandates fast-track special courts and victim compensation.' },
    ],
    helplines: ['112 — National Emergency', 'State SC/ST Commissions — see your state government portal'],
    color: 'just',
  },
  {
    id: 'racism',
    icon: '🌏',
    title: 'Anti-Racism & Regional Equality',
    subtitle: 'Freedom from Discrimination Anywhere in India',
    laws: [
      { ref: 'Article 15(1)', desc: 'Prohibits the State from discriminating against any citizen on grounds of religion, race, caste, sex, or place of birth.' },
      { ref: 'Article 19(1)(d) & (e)', desc: 'Guarantees every citizen the right to move freely throughout India and to reside and settle in any part of the country.' },
      { ref: 'BNS Sections 196 & 353 (formerly IPC 153A / 505)', desc: 'Criminalise promoting enmity between groups and making statements prejudicial to national integration. Racial slurs and derogatory regional epithets are punishable offences.' },
      { ref: 'Bezbaruah Committee (2014)', desc: 'Recommended stiffened penal action against racial profiling and discrimination faced by people from Northeast India in metro cities.' },
    ],
    helplines: ['1093 — Delhi Police North East Helpline', 'Regional student union contacts (see Resources)'],
    color: 'just',
  },
  {
    id: 'animals',
    icon: '🐾',
    title: 'Animal Rights & Prevention of Cruelty',
    subtitle: 'Ahimsa as Constitutional Duty',
    laws: [
      { ref: 'Article 51A(g)', desc: 'Fundamental Duty of every Indian citizen to protect the natural environment and to have compassion for living creatures.' },
      { ref: 'PCA Act, 1960', desc: 'Prevention of Cruelty to Animals Act. Criminalises abandonment, starvation, overwork, and physical abuse of companion and working animals. Cruelty is a cognizable offence.' },
      { ref: 'ABC Rules, 2023', desc: 'Animal Birth Control Rules explicitly prohibit RWAs, local bodies, or any individual from relocating, chasing away, or harming community (stray) dogs. Mandatory response is sterilisation + vaccination through municipal authorities.' },
    ],
    helplines: ['112 — Report animal cruelty', 'Local SPCA / Animal Welfare Board of India'],
    color: 'just',
  },
];

const faqs = [
  {
    id: 'faq-zero-fir',
    question: 'Can police refuse to register my complaint if the crime happened in a different jurisdiction?',
    answer: 'No. Under the Code of Criminal Procedure (CrPC) and upheld by the Supreme Court, any police station must register a "Zero FIR" for any cognizable offence regardless of where it occurred. Refusing to accept your complaint is itself a punishable dereliction of duty. You can then escalate to the Superintendent of Police or the State Human Rights Commission.',
    tag: "Women's Rights",
  },
  {
    id: 'faq-rwa-pets',
    question: 'Can an RWA ban pets from elevators or common areas?',
    answer: "RWAs are governed by their bye-laws, but no RWA can impose rules that discriminate against residents on the basis of pet ownership in a way that violates fundamental rights. Multiple High Court orders have held that blanket elevator bans on pets are not enforceable where no nuisance or hygiene violation has been demonstrated. Pet owners must, however, maintain their pets responsibly (leashing, waste disposal). An RWA's authority is regulatory, not prohibitionary.",
    tag: 'Animal Rights',
  },
  {
    id: 'faq-rwa-dogs',
    question: 'Can an RWA relocate, chase away, or harm community (stray) dogs?',
    answer: 'No. This is explicitly illegal under the Animal Birth Control (ABC) Rules, 2023, and upheld repeatedly by High Courts. Community dogs are protected under the PCA Act, 1960 and ABC Rules. RWAs must coordinate with the local municipal authority for sterilisation and vaccination. Any individual who harms, relocates, or poisons a community dog can be prosecuted under the PCA Act. Community feeders cannot be harassed for feeding strays.',
    tag: 'Animal Rights',
  },
  {
    id: 'faq-landlord-caste',
    question: 'Can a landlord reject a tenant based on caste or food choices?',
    answer: "Article 15 of the Constitution prohibits caste-based discrimination in public contexts. While private landlords have some discretion, rejecting a tenant explicitly on grounds of caste or untouchability can attract liability under the SC/ST Atrocities Act if the tenant belongs to a Scheduled Caste. Discrimination based on food preferences (e.g., refusing non-vegetarians) is legally grey but increasingly challenged. Document all communications and consult a legal aid centre.",
    tag: 'Caste Rights',
  },
  {
    id: 'faq-trans-cert',
    question: 'How do I apply for a Transgender Identity Certificate?',
    answer: "Under the Transgender Persons (Protection of Rights) Act, 2019, you can apply for a Gender Certificate online at transgender.dosje.gov.in. The process: (1) Register on the National Portal for Transgender Persons. (2) Upload required documents. (3) The District Magistrate issues a Certificate of Identity. You don't need any medical certificate or surgery proof to self-identify. If your application is rejected or delayed, you can approach the National Council for Transgender Persons or call the helpline at 14566.",
    tag: 'Trans Rights',
  },
  {
    id: 'faq-slur-legal',
    question: 'Is using a racial slur or derogatory regional name a punishable offence in India?',
    answer: 'Yes. Bharatiya Nyaya Sanhita (BNS) Sections 196 and 353 (formerly IPC Sections 153A and 505) criminalise promoting enmity between groups and making statements prejudicial to national integration — which includes racial slurs and derogatory regional epithets. The Bezbaruah Committee (2014) specifically recommended stiffened action against discrimination of North-East Indians. You can file an FIR at any police station. The Delhi Police operates a dedicated North East Helpline at 1093.',
    tag: 'Anti-Racism',
  },
];

const templates = [
  {
    id: 'shrc-complaint',
    icon: '🏛️',
    title: 'State Human Rights Commission (SHRC) Complaint',
    description: 'Use this template to escalate a rights violation — caste discrimination, police inaction, or housing discrimination — to your State Human Rights Commission.',
    copyText: `To,
The Registrar / Secretary,
[State] Human Rights Commission
[State Capital, PIN]

Subject: Complaint of Human Rights Violation under the Protection of Human Rights Act, 1993

Respected Sir/Madam,

I, [YOUR FULL NAME], aged [AGE], residing at [ADDRESS], hereby submit this complaint against [RESPONDENT NAME/AUTHORITY] for the following violation of my fundamental rights:

1. DETAILS OF INCIDENT:
Date: [DATE OF INCIDENT]
Location: [LOCATION]
Nature of violation: [DESCRIBE — e.g., caste-based discrimination, police refusal to file FIR, etc.]

2. CONSTITUTIONAL / LEGAL PROVISIONS VIOLATED:
[E.g., Article 17 — Abolition of Untouchability; SC/ST Atrocities Act, 1989; Zero FIR obligation under CrPC]

3. RELIEF SOUGHT:
- Inquiry into the violation
- Directions to the respondent authority to cease the violation
- Compensation under Section 18 of the Protection of Human Rights Act, 1993

4. DOCUMENTS ENCLOSED:
- Copy of FIR / complaint filed (if any)
- Photographs / evidence
- Witness statements (if available)

I solemnly declare that the above information is true to the best of my knowledge.

Yours faithfully,
[YOUR NAME]
[CONTACT NUMBER]
[EMAIL]
Date: [DATE]`,
  },
  {
    id: 'anti-cruelty-complaint',
    icon: '🐾',
    title: 'Animal Cruelty Complaint (Police / SPCA)',
    description: 'Use this to file a formal complaint with the police or local SPCA against animal cruelty — including RWA harassment of community dog feeders.',
    copyText: `To,
The Station House Officer (SHO) / In-charge,
[Police Station Name]
[Address]

CC: Society for the Prevention of Cruelty to Animals (SPCA), [District]

Subject: Complaint of Animal Cruelty under the Prevention of Cruelty to Animals (PCA) Act, 1960

Sir/Madam,

I, [YOUR NAME], a resident of [ADDRESS], hereby lodge a formal complaint against [ACCUSED NAME / UNKNOWN] for the following act of animal cruelty:

DATE & TIME: [DATE, TIME]
LOCATION: [LOCATION — apartment complex, street, etc.]
ANIMALS AFFECTED: [Describe — community dogs, pet, working animal, etc.]
DESCRIPTION OF INCIDENT: [Describe in detail — poisoning, physical assault, illegal relocation, withholding food/water, etc.]

RELEVANT LAW VIOLATED:
- Section [11 / 12 / 13] of the Prevention of Cruelty to Animals Act, 1960
- Animal Birth Control (ABC) Rules, 2023 [if RWA-related]
- Article 51A(g) of the Constitution of India — Fundamental Duty of compassion for living creatures

RELIEF REQUESTED:
1. Register an FIR / complaint against the accused
2. Initiate inquiry and take penal action under the PCA Act
3. Direct [RWA / Municipal Authority] to comply with ABC Rules

I am willing to provide further evidence and testify if required.

Yours sincerely,
[YOUR NAME]
[ADDRESS]
[PHONE / EMAIL]
Date: [DATE]`,
  },
  {
    id: 'police-comm-grievance',
    icon: '📝',
    title: 'Police Commissioner Civic Grievance',
    description: 'Escalate police inaction — refusal to file FIR, caste bias, or failure to act on harassment — directly to the Police Commissioner.',
    copyText: `To,
The Commissioner of Police,
[City / District]

Subject: Complaint against Police Inaction / Misconduct at [Police Station Name]

Respected Sir/Madam,

I, [YOUR NAME], residing at [ADDRESS], submit this complaint regarding the failure of [POLICE STATION NAME] to perform its legal duty on [DATE].

INCIDENT DETAILS:
On [DATE], I approached [POLICE STATION] to file a complaint regarding [DESCRIBE INCIDENT].

INACTION / MISCONDUCT:
The duty officer / SHO [NAME IF KNOWN] refused to:
[ ] Register a Zero FIR despite a cognizable offence
[ ] Take action on a complaint of caste-based abuse under the SC/ST Atrocities Act
[ ] Act on an animal cruelty complaint under the PCA Act, 1960
[ ] Other: [SPECIFY]

LEGAL BASIS FOR COMPLAINT:
- The Police Act / CrPC requires any station to register a Zero FIR for cognizable offences
- SC/ST Atrocities Act mandates FIR registration without delay
- Refusal to register an FIR is itself punishable under Section 166A IPC / BNS

RELIEF REQUESTED:
1. Direct the concerned police station to register the FIR immediately
2. Initiate departmental action against the erring officer
3. Provide a written acknowledgment of this complaint

Enclosures: [List any evidence, prior complaints, witness information]

Yours faithfully,
[YOUR NAME]
[CONTACT DETAILS]
Date: [DATE]`,
  },
];
---

<BaseLayout
  title="Intersectional Justice — Protect Their Rights"
  description="Every individual—regardless of gender, caste, origin, or species—holds an inherent right to dignity, safety, and equal protection under the law. Five legal verticals, emergency helplines, Know Your Rights FAQ, and downloadable complaint templates."
  ogImage="/og/justice.png"
>
  <!-- ── Hero ── -->
  <section class="cause-hero" aria-label="Intersectional Justice overview">
    <div class="container">
      <div class="cause-hero__inner">
        <div class="cause-hero__label">
          <span class="tag tag--just">Intersectional Justice</span>
        </div>
        <h1 class="cause-hero__heading">
          Justice is not divisible.<br />
          <span class="cause-hero__accent">It is intersectional or it is nothing.</span>
        </h1>
        <p class="cause-hero__sub">
          Every individual — regardless of gender, caste, origin, or species — holds an inherent right to dignity, safety, and equal protection under the law. We document violations, decode legal safeguards, and connect citizens to justice.
        </p>
        <div class="cause-hero__actions">
          <a href="/intersectional-justice/myths/" class="btn btn-primary" id="just-myths-cta">Read Myth vs. Fact</a>
          <a href="/intersectional-justice/data/" class="btn btn-outline" id="just-data-cta">View Data & Statistics</a>
        </div>
        <div class="cause-hero__share">
          <ShareButtons title="Intersectional Justice - Paras Activist" url="https://parasactivist.in/intersectional-justice/" />
          <a href="https://www.instagram.com/protectheirights" class="insta-handle insta-handle--just" target="_blank" rel="noopener noreferrer" aria-label="Follow @protectheirights on Instagram">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            @protectheirights
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 🚨 Emergency Helpline Hub ── -->
  <section class="helpline-hub" aria-label="Emergency helplines">
    <div class="container">
      <div class="helpline-hub__header">
        <span class="helpline-hub__eyebrow">🚨 In an Emergency — Call Now</span>
        <p class="helpline-hub__note">All numbers are free to call. One-tap on mobile.</p>
      </div>
      <div class="helpline-hub__grid">
        {helplines.map(h => (
          <a href={`tel:${h.number}`} class={`helpline-card helpline-card--${h.color}`} id={`helpline-${h.number}`} aria-label={`Call ${h.label}: ${h.number}`}>
            <span class="helpline-card__icon" aria-hidden="true">{h.icon}</span>
            <span class="helpline-card__number">{h.number}</span>
            <span class="helpline-card__label">{h.label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Key Stats -->
  <section class="section--sm" aria-label="Key statistics">
    <div class="container">
      <div class="stats-grid stagger">
        <StatHighlight number="57,582" label="Registered crimes against Scheduled Castes in 2021 — a widely acknowledged undercount (NCRB)" source="NCRB Crime in India, 2021" color="just" />
        <StatHighlight number="1861" label="Year British colonial law introduced Section 377 — criminalising gender non-conformity in India for 157 years" source="Legal historian Alok Gupta; IPC colonial history" color="just" />
        <StatHighlight number="2014" label="Year the Supreme Court affirmed 'Third Gender' rights in NALSA v. Union of India" source="Supreme Court of India, NALSA, 2014" color="just" />
      </div>
    </div>
  </section>

  <!-- ── ⚖️ Five Legal Verticals ── -->
  <section class="section--sm verticals" aria-label="Five legal verticals — Know your rights">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-eyebrow">⚖️ Legal Framework</span>
        <h2>Five Pillars of Civic Rights</h2>
        <p class="section-sub">
          Constitutional provisions, landmark judgments, and Acts of Parliament. Click any vertical to expand its legal framework.
        </p>
      </div>

      <div class="verticals__list">
        {verticals.map((v, i) => (
          <details class={`vertical-card reveal reveal-delay-${(i % 3) + 1}`} id={`vertical-${v.id}`}>
            <summary class="vertical-card__summary">
              <span class="vertical-card__icon" aria-hidden="true">{v.icon}</span>
              <span class="vertical-card__heading">
                <span class="vertical-card__title">{v.title}</span>
                <span class="vertical-card__subtitle">{v.subtitle}</span>
              </span>
              <span class="vertical-card__chevron" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
              </span>
            </summary>

            <div class="vertical-card__body">
              <ul class="law-list">
                {v.laws.map(law => (
                  <li class="law-item">
                    <span class="law-item__ref">{law.ref}</span>
                    <span class="law-item__desc">{law.desc}</span>
                  </li>
                ))}
              </ul>

              <div class="vertical-card__footer">
                <div class="vertical-card__helplines">
                  <span class="vertical-card__helplines-label">Helplines</span>
                  {v.helplines.map(h => (
                    <span class="helpline-tag">{h}</span>
                  ))}
                </div>
                {v.resource && (
                  <a href={v.resource.href} target="_blank" rel="noopener noreferrer" class="btn btn-outline vertical-card__resource-btn">
                    {v.resource.label} →
                  </a>
                )}
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── ❓ Know Your Rights — FAQ Accordions ── -->
  <section class="section--sm faq-section" aria-label="Know Your Rights — everyday legal scenarios">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-eyebrow">❓ Know Your Rights</span>
        <h2>Everyday Scenarios — Plain-Language Answers</h2>
        <p class="section-sub">
          Real situations. Legal clarity. No jargon.
        </p>
      </div>

      <div class="faq-list">
        {faqs.map((faq, i) => (
          <details class={`faq-item reveal reveal-delay-${(i % 3) + 1}`} id={faq.id}>
            <summary class="faq-item__question">
              <span class="faq-item__tag">{faq.tag}</span>
              <span class="faq-item__q">{faq.question}</span>
              <span class="faq-item__chevron" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
              </span>
            </summary>
            <div class="faq-item__answer">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── 📋 Legal Templates ── -->
  <section class="section--sm templates-section" aria-label="Downloadable legal complaint templates">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-eyebrow">📋 Take Action</span>
        <h2>Legal Complaint Templates — Copy & File</h2>
        <p class="section-sub">
          Standardised, legally grounded complaint formats. Copy in one tap and file with the relevant authority.
        </p>
      </div>

      <div class="templates-grid">
        {templates.map((tmpl, i) => (
          <div class={`template-card reveal reveal-delay-${i + 1}`} id={`template-${tmpl.id}`}>
            <div class="template-card__header">
              <span class="template-card__icon" aria-hidden="true">{tmpl.icon}</span>
              <h3 class="template-card__title">{tmpl.title}</h3>
            </div>
            <p class="template-card__desc">{tmpl.description}</p>
            <pre class="template-card__preview" aria-label="Template preview">{tmpl.copyText.split('\n').slice(0, 6).join('\n')}
…</pre>
            <button
              class="btn btn-outline template-card__copy"
              id={`copy-tmpl-${i}`}
              data-copy={tmpl.copyText}
              type="button"
              aria-label={`Copy ${tmpl.title} template`}
            >
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              Copy Full Template
            </button>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Articles -->
  {articles.length > 0 && (
    <section class="section--sm" aria-label="Justice articles">
      <div class="container">
        <h2>Articles & Analysis</h2>
        <div class="article-list">
          {articles.map(article => (
            <a href={`/intersectional-justice/${article.id}/`} class="article-card">
              <div class="article-card__date">
                <time datetime={article.data.publishDate.toISOString()}>
                  {article.data.publishDate.toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
              </div>
              <h3 class="article-card__title">{article.data.title}</h3>
              <p class="article-card__description">{article.data.description}</p>
              <span class="article-card__read">Read -></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Cause nav -->
  <section class="section--sm cause-nav" aria-label="Explore intersectional justice">
    <div class="container">
      <h2>Explore Intersectional Justice</h2>
      <div class="cause-nav__grid">
        <a href="/intersectional-justice/myths/" class="cause-nav__card" id="nav-just-myths">
          <span class="cause-nav__icon">⚖️</span>
          <h3>Myth vs. Fact</h3>
          <p>Counter "Western import" rhetoric, caste denial, and anti-animal-rights narratives with evidence.</p>
        </a>
        <a href="/intersectional-justice/data/" class="cause-nav__card" id="nav-just-data">
          <span class="cause-nav__icon">📊</span>
          <h3>Data & Statistics</h3>
          <p>NCRB crime data, Supreme Court judgments, key laws and Acts — all cited.</p>
        </a>
        <a href="/share-toolkit" class="cause-nav__card" id="nav-just-share">
          <span class="cause-nav__icon">📲</span>
          <h3>Share Toolkit</h3>
          <p>WhatsApp-ready cards countering misinformation about trans rights, caste, and animal welfare.</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Hero ── */
  .cause-hero { padding-block: var(--space-16) var(--space-12); position: relative; overflow: hidden; }
  .cause-hero::before { content: ''; position: absolute; top: 0; right: 0; width: 40vw; height: 40vw; background: radial-gradient(circle, var(--clr-just-bg) 0%, transparent 60%); pointer-events: none; }
  .cause-hero__inner { position: relative; z-index: 1; max-width: 720px; }
  .cause-hero__label { margin-bottom: var(--space-5); }
  .cause-hero__heading { margin-bottom: var(--space-5); font-size: clamp(2rem, 5vw, 3.25rem); }
  .cause-hero__accent { color: var(--clr-just); }
  .cause-hero__sub { color: var(--clr-text-muted); font-size: 1.0625rem; max-width: 60ch; margin-bottom: var(--space-8); line-height: 1.7; }
  .cause-hero__actions { display: flex; gap: var(--space-4); flex-wrap: wrap; margin-bottom: var(--space-8); }
  .cause-hero__share { display: flex; flex-direction: column; align-items: flex-start; }
