---
// src/pages/intersectional-justice/data.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatHighlight from '../../components/StatHighlight.astro';
import ShareButtons from '../../components/ShareButtons.astro';
---

<BaseLayout
  title="Intersectional Justice Data & Statistics"
  description="Primary source data on caste-based discrimination, trans rights, and animal welfare in India - NCRB crime data, Oxfam inequality reports, and Supreme Court judgments."
  ogImage="/og/just-data.png"
>
  <div class="data-page">
    <div class="container">
      <header class="data-page__header">
        <a href="/intersectional-justice/" class="breadcrumb-back">← Intersectional Justice</a>
        <span class="tag tag--just">Data & Statistics</span>
        <h1>Intersectional Justice: Data & Statistics</h1>
        <p class="data-page__sub">
          All data is sourced from primary government records, judicial judgments, UN agency reports, or peer-reviewed scholarship. Each figure links to its source.
        </p>
        <ShareButtons title="Intersectional Justice Data - Paras Activist" url="https://parasactivist.in/intersectional-justice/data/" />
      </header>

      <div class="stats-showcase stagger">
        <StatHighlight number="57,582" label="Registered crimes against SCs in 2021 - widespread undercount acknowledged (NCRB)" source="NCRB Crime in India, 2021" color="just" />
        <StatHighlight number="1861" label="Year Section 377 was introduced as British colonial law, criminalising gender non-conformity" source="IPC colonial legal history" color="just" />
        <StatHighlight number="2014" label="Year India's Supreme Court affirmed third gender rights in NALSA v. Union of India" source="Supreme Court of India, NALSA, 2014" color="just" />
        <StatHighlight number="2018" label="Year Section 377 was partially struck down in Navtej Singh Johar v. UOI — decriminalising consensual queer relations" source="Supreme Court of India, 2018" color="just" />
        <StatHighlight number="2019" label="Transgender Persons (Protection of Rights) Act passed — prohibiting discrimination in employment, education & healthcare" source="Ministry of Social Justice & Empowerment, GoI" color="just" />
        <StatHighlight number="Article 17" label="Abolition of Untouchability — its practice in any form is a punishable offence under the Constitution of India, 1950" source="Constitution of India, Part III Fundamental Rights" color="just" />
      </div>

      <!-- NCRB Table -->
      <section class="data-table-section">
        <h2>Crimes Against Scheduled Castes - India Trend (NCRB)</h2>
        <div class="table-wrapper" role="region" aria-label="NCRB crime data table" tabindex="0">
          <table class="data-table">
            <thead>
              <tr>
                <th scope="col">Year</th>
                <th scope="col">Registered Crimes Against SCs</th>
                <th scope="col">Change YoY</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>2021</td><td>57,582</td><td>+1.2%</td></tr>
              <tr><td>2020</td><td>50,900</td><td>-3.1%</td></tr>
              <tr><td>2019</td><td>45,961</td><td>+7.3%</td></tr>
              <tr><td>2018</td><td>42,793</td><td>+5.0%</td></tr>
              <tr><td>2017</td><td>40,801</td><td>-</td></tr>
            </tbody>
          </table>
        </div>
        <p class="source-note">Source: <a href="https://ncrb.gov.in" target="_blank" rel="noopener noreferrer">NCRB Crime in India (annual)</a> | Note: These are <em>registered</em> crimes. Actual incidence is estimated to be significantly higher due to underreporting.</p>
      </section>

      <!-- Key Laws & Acts Table -->
      <section class="data-table-section">
        <h2>Key Laws, Acts & Landmark Judgments</h2>
        <p class="data-table__note">A reference guide to the constitutional provisions and legal instruments protecting rights in India across all five verticals.</p>
        <div class="table-wrapper" role="region" aria-label="Key laws and judgments table" tabindex="0">
          <table class="data-table">
            <thead>
              <tr>
                <th scope="col">Law / Judgment</th>
                <th scope="col">Year</th>
                <th scope="col">Vertical</th>
                <th scope="col">What it Protects</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>NALSA v. Union of India</td><td>2014</td><td class="tag-cell tag-cell--trans">Trans Rights</td><td>Third gender legal recognition under Articles 14 & 21</td></tr>
              <tr><td>Navtej Singh Johar v. UOI</td><td>2018</td><td class="tag-cell tag-cell--trans">Queer Rights</td><td>Decriminalisation of consensual same-sex relations</td></tr>
              <tr><td>Trans Persons Act</td><td>2019</td><td class="tag-cell tag-cell--trans">Trans Rights</td><td>Prohibition of discrimination in employment, education, healthcare</td></tr>
              <tr><td>SC/ST Atrocities Act</td><td>1989 / 2018</td><td class="tag-cell tag-cell--caste">Caste Rights</td><td>Penal action for caste-based violence; fast-track courts</td></tr>
              <tr><td>POSH Act</td><td>2013</td><td class="tag-cell tag-cell--women">Women's Rights</td><td>Workplace sexual harassment; mandatory ICC in all offices</td></tr>
              <tr><td>PWDVA</td><td>2005</td><td class="tag-cell tag-cell--women">Women's Rights</td><td>Domestic violence protection, residence & monetary orders</td></tr>
              <tr><td>PCA Act</td><td>1960</td><td class="tag-cell tag-cell--animal">Animal Rights</td><td>Criminalises abandonment, starvation & cruelty to animals</td></tr>
              <tr><td>ABC Rules</td><td>2023</td><td class="tag-cell tag-cell--animal">Animal Rights</td><td>Prohibits RWA relocation/harm of community dogs</td></tr>
              <tr><td>BNS Sections 196 & 353</td><td>2023</td><td class="tag-cell tag-cell--region">Anti-Racism</td><td>Criminalises racial slurs & promoting enmity between groups</td></tr>
            </tbody>
          </table>
        </div>
        <p class="source-note">Sources: Ministry of Law & Justice, Government of India; Supreme Court of India; Animal Welfare Board of India</p>
      </section>

      <!-- Key Judgments -->
      <section class="primary-sources-section">
        <h2>Key Legal Milestones</h2>
        <div class="source-cards">
          <a href="https://main.sci.gov.in" target="_blank" rel="noopener noreferrer" class="source-card">
            <span class="source-card__type">Official Supreme Court Judgment</span>
            <h3>NALSA v. Union of India (2014)</h3>
            <p>Landmark judgment affirming the legal recognition of third gender. Directed governments to implement welfare measures for transgender persons.</p>
          </a>
          <a href="https://main.sci.gov.in" target="_blank" rel="noopener noreferrer" class="source-card">
            <span class="source-card__type">Official Supreme Court Judgment</span>
            <h3>Navtej Singh Johar v. UOI (2018)</h3>
            <p>Partially struck down Section 377 of the IPC, decriminalising consensual same-sex relations between adults.</p>
          </a>
          <a href="https://transgender.dosje.gov.in" target="_blank" rel="noopener noreferrer" class="source-card">
            <span class="source-card__type">Official Government Portal</span>
            <h3>National Transgender Portal</h3>
            <p>Apply for a Gender Identity Certificate under the Transgender Persons (Protection of Rights) Act, 2019.</p>
          </a>
          <a href="https://legislative.gov.in" target="_blank" rel="noopener noreferrer" class="source-card">
            <span class="source-card__type">Act of Parliament</span>
            <h3>SC/ST Atrocities Act, 1989 (Amended 2018)</h3>
            <p>Severe penal consequences for caste-based violence, institutional boycotts, and denial of customary rights. Mandates fast-track courts.</p>
          </a>
          <a href="https://legislative.gov.in" target="_blank" rel="noopener noreferrer" class="source-card">
            <span class="source-card__type">Act of Parliament</span>
            <h3>Prevention of Cruelty to Animals Act, 1960</h3>
            <p>Criminalises abandonment, starvation, overwork, and physical abuse of animals. Cruelty is a cognizable offence under Section 11.</p>
          </a>
          <a href="https://dahd.gov.in" target="_blank" rel="noopener noreferrer" class="source-card">
            <span class="source-card__type">Government Rules</span>
            <h3>Animal Birth Control (ABC) Rules, 2023</h3>
            <p>Explicitly prohibits RWAs and local bodies from relocating or harming community dogs. Mandates sterilisation and vaccination.</p>
          </a>
          <a href="https://ncrb.gov.in" target="_blank" rel="noopener noreferrer" class="source-card">
            <span class="source-card__type">Official Government</span>
            <h3>NCRB Crime in India 2021</h3>
            <p>Annual national crime statistics including caste-based violence, crimes against women, and SC/ST atrocities data.</p>
          </a>
          <a href="https://oxfamindia.org" target="_blank" rel="noopener noreferrer" class="source-card">
            <span class="source-card__type">Independent NGO Report</span>
            <h3>Oxfam India Inequality Report 2022</h3>
            <p>Wage, land ownership, and credit access disparities by caste — controlling for education level. Documents structural economic discrimination.</p>
          </a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .data-page { padding-block: var(--space-8) var(--space-20); }
  .data-page__header { display: flex; flex-direction: column; gap: var(--space-4); margin-bottom: var(--space-10); max-width: 720px; }
  .breadcrumb-back { font-size: 0.875rem; color: var(--clr-text-muted); text-decoration: none; display: inline-flex; align-items: center; gap: var(--space-1); transition: color var(--duration-fast) var(--ease-out); }
  .breadcrumb-back:hover { color: var(--clr-just); }
  .data-page__header h1 { margin: 0; }
  .data-page__sub { color: var(--clr-text-muted); font-size: 1rem; max-width: 60ch; line-height: 1.7; margin: 0; }
  .stats-showcase { display: flex; flex-direction: column; gap: var(--space-4); margin-bottom: var(--space-12); }
  .data-table-section, .primary-sources-section { margin-top: var(--space-12); }
  .data-table-section h2, .primary-sources-section h2 { margin-bottom: var(--space-4); }
  .source-note { font-size: 0.8rem; color: var(--clr-text-muted); margin-top: var(--space-3); }
  .source-note a { color: var(--clr-accent); }
  .table-wrapper { overflow-x: auto; border: 1px solid var(--clr-border); border-radius: var(--radius-lg); margin-bottom: var(--space-2); }
  .data-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .data-table th, .data-table td { padding: var(--space-4) var(--space-5); text-align: left; border-bottom: 1px solid var(--clr-border); }
  .data-table th { background: var(--clr-bg-surface); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--clr-text-muted); }
  .data-table tbody tr:last-child td { border-bottom: none; }
  .data-table tbody tr:hover { background: var(--clr-bg-elevated); }
  .source-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }
  @media (max-width: 960px) { .source-cards { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 700px) { .source-cards { grid-template-columns: 1fr; } }
  /* Law table tag cells */
  .tag-cell { font-size: 0.72rem; font-weight: 800; padding: 3px var(--space-2); border-radius: var(--radius-full); white-space: nowrap; }
  .tag-cell--trans { background: rgba(167,139,250,0.15); color: #a78bfa; }
  .tag-cell--women { background: var(--clr-just-bg); color: var(--clr-just); }
  .tag-cell--caste { background: rgba(251,191,36,0.15); color: var(--clr-warning); }
  .tag-cell--animal { background: rgba(74,222,128,0.1); color: var(--clr-success); }
  .tag-cell--region { background: rgba(96,165,250,0.12); color: var(--clr-foot); }
  .data-table__note { font-size: 0.8rem; color: var(--clr-text-muted); margin-bottom: var(--space-4); }
  .source-card { display: block; background: var(--clr-bg-surface); border: 1px solid var(--clr-border); border-radius: var(--radius-lg); padding: var(--space-5); text-decoration: none; transition: all var(--duration-normal) var(--ease-out); }
  .source-card:hover { border-color: var(--clr-just); transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .source-card__type { font-size: 0.75rem; font-weight: 600; color: var(--clr-text-muted); display: block; margin-bottom: var(--space-2); }
  .source-card h3 { font-size: 0.9375rem; font-weight: 700; color: var(--clr-just); margin-bottom: var(--space-2); }
  .source-card p { font-size: 0.85rem; color: var(--clr-text-muted); margin: 0; line-height: 1.5; }
</style>


