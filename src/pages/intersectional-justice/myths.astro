---
// src/pages/intersectional-justice/myths.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import MythFact from '../../components/MythFact.astro';
import StatHighlight from '../../components/StatHighlight.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import EvidenceCard from '../../components/EvidenceCard.astro';
---

<BaseLayout
  title="Intersectional Justice Myths vs. Facts"
  description="Countering caste denial, anti-trans rhetoric, and 'Western import' propaganda with NCRB data, Supreme Court judgments, and documented Indian history."
  ogImage="/og/just-myths.png"
>
  <div class="myth-page">
    <div class="container">
      <header class="myth-page__header">
        <a href="/intersectional-justice/" class="breadcrumb-back">← Intersectional Justice</a>
        <span class="tag tag--just">⚖️ Myth vs. Fact</span>
        <h1>Intersectional Justice: <br class="hide-desktop" />Myths vs. Facts</h1>
        <p class="myth-page__sub">
          These are the specific narratives used to delegitimise trans rights, deny caste discrimination, and suppress animal welfare advocacy. Each is addressed with named, verifiable sources.
        </p>
        <ShareButtons title="Intersectional Justice Myths vs. Facts — Paras Activist" url="https://parasactivist.in/intersectional-justice/myths/" />
      </header>

      <EvidenceCard
        primarySources="3 government sources (NCRB, Supreme Court), 1 UN agency, 2 academic texts, 1 Oxfam report"
        lastVerified="August 2025"
        corrections={0}
      />

      <MythFact
        myth="Caste discrimination is a thing of the past. The reservation system has levelled the playing field."
        fact="The NCRB recorded 57,582 registered crimes against Scheduled Castes in 2021 alone — a figure widely acknowledged as a drastic undercount due to systematic under-reporting and police inaction. Oxfam India's Inequality Report 2022 shows SC and ST households earn significantly lower wages, own less land, and have lower rates of access to formal credit than forward-caste counterparts — controlling for education level. Reservations address access to government jobs and education. They cannot resolve social violence, private-sector discrimination, or untouchability in daily life."
        sources="NCRB Crime in India 2021; Oxfam India, India Inequality Report 2022: Digital Divide; Sukhadeo Thorat & Paul Attewell, 'The Legacy of Social Exclusion,' Economic & Political Weekly."
      />

      <StatHighlight number="57,582" label="Registered crimes against Scheduled Castes in 2021 — a significant undercount (NCRB)" source="National Crime Records Bureau, Crime in India 2021" color="just" />

      <MythFact
        myth="Trans rights and animal rights are 'Western' imports that are irrelevant to Indian culture."
        fact="Hijra and Kinnar communities have documented histories spanning thousands of years in India — with roles in Mughal courts, regional kingdoms, and Hindu and Islamic traditions. The criminalisation of gender non-conformity under Section 377 was itself a British colonial imposition introduced in 1861. The rights framework is being reclaimed, not imported. Similarly, the principle of ahimsa (non-violence toward all living beings) is foundational to Jainism, Buddhism, and several Hindu traditions — all indigenous to the subcontinent."
        sources="NALSA v. Union of India, Supreme Court of India (2014); Legal historian Alok Gupta on Section 377's colonial origins; Gopi Shankar Madurai, Itihas mein Tritiya Prakriti; Angma Jhala, Royal Patronage, Power and Aesthetics in Princely India."
      />

      <StatHighlight number="1861" label="Year British colonial law introduced Section 377 — criminalising gender non-conformity in India for 157 years" source="Legal historian Alok Gupta; IPC historical record" color="just" />

      <MythFact
        myth="Women's rights and animal rights are separate issues. Combining them weakens both movements."
        fact="Violence against women and violence against animals frequently co-occur in the same households and perpetrated by the same individuals — a pattern documented extensively by criminologists and feminist scholars (the 'Link' between domestic abuse and animal abuse). Intersectional advocacy recognises shared structures of domination: patriarchy, caste hierarchy, and speciesism all rest on the logic of 'this group's suffering does not count.' Combining these movements strengthens both by building a broader coalition and identifying root causes — not weakens them."
        sources="Adams C.J. (1990), The Sexual Politics of Meat; Flynn C.P. (2011), 'Examining the Link Between Animal Abuse and Human Violence,' Crime, Law and Social Change; Pew Research on co-occurrence of abuse."
      />

      <section class="sources-section">
        <h2>Full Source List</h2>
        <ol class="source-list">
          <li><strong>NCRB Crime in India 2021</strong> — National Crime Records Bureau, Ministry of Home Affairs, Government of India. <a href="https://ncrb.gov.in" target="_blank" rel="noopener noreferrer">ncrb.gov.in</a></li>
          <li><strong>Oxfam India Inequality Report 2022</strong> — India Inequality Report: Digital Divide. <a href="https://oxfamindia.org" target="_blank" rel="noopener noreferrer">oxfamindia.org</a></li>
          <li><strong>NALSA v. Union of India (2014)</strong> — Supreme Court of India. Landmark judgment affirming legal recognition of third gender. Available via <a href="https://main.sci.gov.in" target="_blank" rel="noopener noreferrer">main.sci.gov.in</a></li>
          <li><strong>Thorat S. & Attewell P. (2007)</strong> — "The Legacy of Social Exclusion: A Correspondence Study of Job Discrimination in India." <em>Economic & Political Weekly</em>.</li>
          <li><strong>Gopi Shankar Madurai</strong> — <em>Itihas mein Tritiya Prakriti</em> — Historical documentation of gender non-conforming communities in India.</li>
          <li><strong>Gupta A.</strong> — Historical analysis of Section 377 as a colonial imposition. Multiple published works cited in Supreme Court judgment.</li>
          <li><strong>Adams C.J. (1990)</strong> — <em>The Sexual Politics of Meat</em>. Continuum Publishing. On intersectional analysis of patriarchy and speciesism.</li>
        </ol>
      </section>

      <div class="myth-page__share-footer">
        <p>Share this evidence:</p>
        <ShareButtons title="Intersectional Justice Myths vs. Facts — Paras Activist" url="https://parasactivist.in/intersectional-justice/myths/" />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .myth-page { padding-block: var(--space-8) var(--space-20); }
  .myth-page__header { max-width: 720px; margin-bottom: var(--space-10); display: flex; flex-direction: column; gap: var(--space-4); }
  .breadcrumb-back { font-size: 0.875rem; color: var(--clr-text-muted); text-decoration: none; display: inline-flex; align-items: center; gap: var(--space-1); transition: color var(--duration-fast) var(--ease-out); }
  .breadcrumb-back:hover { color: var(--clr-just); }
  .myth-page__header h1 { margin: 0; }
  .myth-page__sub { color: var(--clr-text-muted); font-size: 1rem; max-width: 60ch; line-height: 1.7; margin: 0; }
  .sources-section { margin-top: var(--space-12); padding: var(--space-8); background: var(--clr-bg-surface); border: 1px solid var(--clr-border); border-radius: var(--radius-lg); }
  .sources-section h2 { margin-bottom: var(--space-6); font-size: 1.125rem; }
  .source-list { list-style: decimal; padding-left: var(--space-6); display: flex; flex-direction: column; gap: var(--space-4); }
  .source-list li { font-size: 0.9rem; color: var(--clr-text-muted); line-height: 1.6; }
  .source-list a { color: var(--clr-accent); text-decoration: underline; text-underline-offset: 3px; }
  .myth-page__share-footer { margin-top: var(--space-12); padding-top: var(--space-8); border-top: 1px solid var(--clr-border); display: flex; align-items: center; gap: var(--space-6); flex-wrap: wrap; }
  .myth-page__share-footer p { font-weight: 600; color: var(--clr-text-muted); margin: 0; font-size: 0.875rem; }
</style>
