---
// MythFact.astro — striking myth vs. fact block for use in MDX and pages
interface Props {
  myth: string;
  fact: string;
  sources?: string;
}

const { myth, fact, sources } = Astro.props;
---

<div class="myth-fact" role="group" aria-label="Myth versus Fact">
  <div class="myth-fact__myth">
    <div class="myth-fact__label myth-fact__label--myth">
      <span aria-hidden="true">🔴</span>
      <span>MYTH</span>
    </div>
    <p class="myth-fact__text">{myth}</p>
  </div>

  <div class="myth-fact__divider" aria-hidden="true">
    <div class="myth-fact__divider-line"></div>
    <span class="myth-fact__divider-icon">⟶</span>
    <div class="myth-fact__divider-line"></div>
  </div>

  <div class="myth-fact__fact">
    <div class="myth-fact__label myth-fact__label--fact">
      <span aria-hidden="true">✅</span>
      <span>FACT</span>
    </div>
    <p class="myth-fact__text">{fact}</p>
    {sources && (
      <p class="myth-fact__sources">
        <strong>Sources:</strong> {sources}
      </p>
    )}
  </div>
</div>

<style>
  .myth-fact {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-4);
    align-items: center;
    background: var(--clr-bg-surface);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    margin-block: var(--space-8);
    transition: box-shadow var(--duration-normal) var(--ease-out);
  }

  .myth-fact:hover {
    box-shadow: var(--shadow-lg);
  }

  @media (max-width: 700px) {
    .myth-fact {
      grid-template-columns: 1fr;
    }
    .myth-fact__divider {
      display: flex;
      flex-direction: row;
      justify-content: center;
    }
  }

  .myth-fact__myth {
    background: rgba(248, 113, 113, 0.05);
    border: 1px solid rgba(248,113,113,0.2);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }

  .myth-fact__fact {
    background: rgba(74, 222, 128, 0.05);
    border: 1px solid rgba(74,222,128,0.2);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }

  .myth-fact__label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: var(--space-3);
  }

  .myth-fact__label--myth { color: var(--clr-danger); }
  .myth-fact__label--fact { color: var(--clr-success); }

  .myth-fact__text {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--clr-text);
    margin: 0;
  }

  .myth-fact__sources {
    margin-top: var(--space-4);
    font-size: 0.8rem;
    color: var(--clr-text-muted);
    line-height: 1.5;
    border-top: 1px dashed var(--clr-border);
    padding-top: var(--space-3);
  }

  .myth-fact__divider {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .myth-fact__divider-line {
    width: 2px;
    flex: 1;
    background: var(--clr-border);
    min-height: 24px;
  }

  .myth-fact__divider-icon {
    font-size: 1.25rem;
    color: var(--clr-text-subtle);
    transform: rotate(90deg);
  }

  @media (max-width: 700px) {
    .myth-fact__divider-line { width: 32px; height: 2px; flex: none; }
    .myth-fact__divider-icon { transform: rotate(0deg); }
  }
</style>
