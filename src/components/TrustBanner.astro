---
// TrustBanner.astro - sticky zero-tracking pledge banner
---

<div class="trust-banner" id="trust-banner" role="banner" aria-label="Privacy notice">
  <div class="trust-banner__inner container">
    <div class="trust-banner__pills">
      <span class="trust-pill" aria-label="No cookies">
        <span class="trust-pill__dot trust-pill__dot--green" aria-hidden="true"></span>
        No cookies
      </span>
      <span class="trust-banner__sep" aria-hidden="true">/</span>
      <span class="trust-pill" aria-label="No trackers">
        <span class="trust-pill__dot trust-pill__dot--green" aria-hidden="true"></span>
        No trackers
      </span>
      <span class="trust-banner__sep" aria-hidden="true">/</span>
      <span class="trust-pill" aria-label="No ads">
        <span class="trust-pill__dot trust-pill__dot--green" aria-hidden="true"></span>
        No ads
      </span>
      <span class="trust-banner__sep trust-banner__sep--lg" aria-hidden="true">/</span>
      <a href="/about#pledge" class="trust-banner__link" aria-label="Read our full privacy pledge">
        Read our pledge <span aria-hidden="true">-&gt;</span>
      </a>
    </div>

    <button
      class="trust-banner__close"
      id="trust-banner-close"
      aria-label="Dismiss privacy notice"
      type="button"
    >
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
        <path d="M1 1l10 10M11 1L1 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
</div>

<script>
  const banner = document.getElementById('trust-banner');
  const closeBtn = document.getElementById('trust-banner-close');
  if (closeBtn && banner) {
    closeBtn.addEventListener('click', () => {
      banner.classList.add('trust-banner--hidden');
    });
  }
</script>

<style>
  .trust-banner {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(8, 10, 15, 0.88);
    border-bottom: 1px solid rgba(245, 166, 35, 0.18);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    max-height: var(--banner-height, 48px);
    overflow: hidden;
    transition: max-height var(--duration-normal) var(--ease-out),
                opacity var(--duration-normal) var(--ease-out),
                padding-block var(--duration-normal) var(--ease-out),
                border-bottom-color var(--duration-normal) var(--ease-out);
  }

  .trust-banner--hidden {
    max-height: 0;
    padding-block: 0;
    opacity: 0;
    pointer-events: none;
    overflow: hidden;
    border-bottom-color: transparent;
  }

  .trust-banner__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: 10px;
  }

  .trust-banner__pills {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .trust-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--clr-text-muted);
    letter-spacing: 0;
  }

  .trust-pill__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .trust-pill__dot--green {
    background: var(--clr-success);
    box-shadow: 0 0 6px var(--clr-food-glow);
    animation: pulseGlow 2.5s ease-in-out infinite;
  }

  .trust-banner__sep {
    color: var(--clr-border);
    font-size: 0.75rem;
    user-select: none;
  }

  .trust-banner__sep--lg { margin-inline: var(--space-1); }

  .trust-banner__link {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--clr-accent);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
    white-space: nowrap;
  }
  .trust-banner__link:hover { color: var(--clr-accent-bright); }

  .trust-banner__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: transparent;
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-full);
    cursor: pointer;
    color: var(--clr-text-subtle);
    flex-shrink: 0;
    transition: color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out), background var(--duration-fast) var(--ease-out);
  }
  .trust-banner__close:hover {
    color: var(--clr-text);
    border-color: var(--clr-text-subtle);
    background: var(--clr-bg-elevated);
  }

  @media (max-width: 480px) {
    .trust-banner__sep--lg,
    .trust-banner__link { display: none; }
  }
</style>


