---
// Footer.astro
const causes = [
  { label: 'Food Security', href: '/food-security/', icon: '🌾', tag: 'food' },
  { label: 'Footpath Movement', href: '/footpath/', icon: '🚶', tag: 'foot' },
  { label: 'Intersectional Justice', href: '/intersectional-justice/', icon: '⚖️', tag: 'just' },
];
---

<footer class="footer" role="contentinfo">
  <!-- Gradient divider -->
  <div class="footer__gradient-rule" aria-hidden="true"></div>

  <div class="container">
    <div class="footer__grid">
      <!-- Brand -->
      <div class="footer__brand">
        <a href="/" class="footer__logo" aria-label="Home">
          <span class="footer__logo-mark" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M11 2L13.5 8.5H20.5L14.75 12.75L17 19.5L11 15.25L5 19.5L7.25 12.75L1.5 8.5H8.5L11 2Z" fill="currentColor"/>
            </svg>
          </span>
          <span>Paras<span class="footer__logo-accent">Activist</span></span>
        </a>
        <p class="footer__tagline">
          Three movements. One commitment.<br/>
          <strong>Evidence over propaganda.</strong>
        </p>
        <div class="footer__pledge-chips" role="note" aria-label="Privacy pledge">
          <span class="footer__chip">
            <span class="footer__chip-dot" aria-hidden="true"></span>
            No cookies
          </span>
          <span class="footer__chip">
            <span class="footer__chip-dot" aria-hidden="true"></span>
            No trackers
          </span>
          <span class="footer__chip">
            <span class="footer__chip-dot" aria-hidden="true"></span>
            No ads
          </span>
        </div>
      </div>

      <!-- Causes -->
      <div class="footer__col">
        <h3 class="footer__col-title">Causes</h3>
        <ul role="list">
          {causes.map(c => (
            <li>
              <a href={c.href} class={`footer__link footer__link--${c.tag}`}>
                <span aria-hidden="true">{c.icon}</span> {c.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Site -->
      <div class="footer__col">
        <h3 class="footer__col-title">Site</h3>
        <ul role="list">
          <li><a href="/about" class="footer__link">About & Our Pledge</a></li>
          <li><a href="/sources" class="footer__link">Master Bibliography</a></li>
          <li><a href="/share-toolkit" class="footer__link">Share Toolkit</a></li>
        </ul>
      </div>

      <!-- Share -->
      <div class="footer__col">
        <h3 class="footer__col-title">Share</h3>
        <ul role="list">
          <li>
            <a
              href="https://www.instagram.com/"
              class="footer__link"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram (opens in new tab)"
            >
              📸 Instagram
            </a>
          </li>
          <li>
            <a href="/share-toolkit" class="footer__link">
              📲 WhatsApp Cards
            </a>
          </li>
          <li>
            <a href="/share-toolkit" class="footer__link">
              ✈️ Telegram Cards
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__copy">
        © {new Date().getFullYear()} Paras Activist. All content is freely shareable for non-commercial educational use with attribution.
      </p>
      <p class="footer__disclaimer">
        This site contains no advertising, no affiliate links, and no data collection of any kind. Content is evidence-based and independently funded.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--clr-bg-surface);
    padding-top: var(--space-16);
    padding-bottom: var(--space-8);
    margin-top: var(--space-20);
    position: relative;
  }

  .footer__gradient-rule {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--clr-border) 15%,
      rgba(245,166,35,0.3) 35%,
      var(--clr-accent) 50%,
      rgba(245,166,35,0.3) 65%,
      var(--clr-border) 85%,
      transparent 100%
    );
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-8);
    margin-bottom: var(--space-12);
  }

  @media (max-width: 900px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer__brand { grid-column: 1 / -1; }
  }

  @media (max-width: 500px) {
    .footer__grid { grid-template-columns: 1fr; }
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 800;
    font-size: 1.125rem;
    text-decoration: none;
    color: var(--clr-text);
    letter-spacing: -0.025em;
    margin-bottom: var(--space-4);
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  .footer__logo:hover { color: var(--clr-text); opacity: 0.8; }

  .footer__logo-mark { color: var(--clr-accent); display: flex; align-items: center; }
  .footer__logo-accent { color: var(--clr-accent); }

  .footer__tagline {
    color: var(--clr-text-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
    max-width: 30ch;
    margin-bottom: var(--space-5);
  }
  .footer__tagline strong { color: var(--clr-text); }

  /* Pledge chips */
  .footer__pledge-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .footer__chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--clr-bg-elevated);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-full);
    padding: 4px var(--space-3);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--clr-text-muted);
  }

  .footer__chip-dot {
    width: 6px;
    height: 6px;
    background: var(--clr-success);
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: 0 0 5px rgba(74,222,128,0.5);
  }

  .footer__col-title {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--clr-text-subtle);
    margin-bottom: var(--space-4);
  }

  .footer__col ul { list-style: none; display: flex; flex-direction: column; gap: var(--space-3); }

  .footer__link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--clr-text-muted);
    font-size: 0.9rem;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }
  .footer__link:hover { color: var(--clr-accent); }
  .footer__link--food:hover { color: var(--clr-food); }
  .footer__link--foot:hover { color: var(--clr-foot); }
  .footer__link--just:hover { color: var(--clr-just); }

  .footer__bottom {
    padding-top: var(--space-8);
    border-top: 1px solid var(--clr-border);
  }

  .footer__copy, .footer__disclaimer {
    font-size: 0.8125rem;
    color: var(--clr-text-subtle);
    line-height: 1.6;
  }

  .footer__copy { margin-bottom: var(--space-2); }
</style>
