---
// CauseCard.astro - homepage pillar navigation card
interface Props {
  title: string;
  href: string;
  description: string;
  stat: string;
  statLabel: string;
  code: string;
  tag: 'food' | 'foot' | 'just';
  mythsHref: string;
  dataHref: string;
}

const { title, href, description, stat, statLabel, code, tag, mythsHref, dataHref } = Astro.props;
const match = stat.replace(/,/g, '').match(/^([^0-9]*)([0-9]+(?:\.[0-9]+)?)(.*)$/);
const statPrefix = match ? match[1] : '';
const statCount  = match ? match[2] : '';
const statSuffix = match ? match[3] : '';
---

<article class={`cause-card cause-card--${tag}`} aria-label={title}>
  <div class="cause-card__accent-bar" aria-hidden="true"></div>

  <div class="cause-card__header">
    <div class={`cause-card__code cause-card__code--${tag}`} aria-hidden="true">{code}</div>
    <span class={`tag tag--${tag}`}>{title}</span>
  </div>

  <div class="cause-card__stat">
    <div
      class="cause-card__stat-number"
      data-count={statCount}
      data-prefix={statPrefix}
      data-suffix={statSuffix}
      aria-label={stat}
    >{stat}</div>
    <div class="cause-card__stat-label">{statLabel}</div>
  </div>

  <p class="cause-card__description">{description}</p>

  <div class="cause-card__actions">
    <a href={mythsHref} class="btn btn-outline cause-card__btn">
      Myth vs. Fact
    </a>
    <a href={dataHref} class="btn btn-ghost cause-card__btn">
      View Data
      <span aria-hidden="true" class="cause-card__arrow">-&gt;</span>
    </a>
  </div>

  <a href={href} class="cause-card__overlay-link" aria-label={`Open ${title}`}></a>
</article>

<style>
  .cause-card {
    position: relative;
    background: linear-gradient(180deg, rgba(22, 26, 36, 0.94), rgba(14, 17, 24, 0.98));
    border: 1px solid var(--clr-border);
    border-top: none;
    border-radius: var(--radius-lg);
    padding: var(--space-7, 1.75rem) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    min-height: 100%;
    transition: all var(--duration-normal) var(--ease-out);
    overflow: hidden;
  }

  .cause-card__accent-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    opacity: 0.85;
  }

  .cause-card--food .cause-card__accent-bar { background: var(--clr-food); }
  .cause-card--foot .cause-card__accent-bar { background: var(--clr-foot); }
  .cause-card--just .cause-card__accent-bar { background: var(--clr-just); }

  .cause-card::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--duration-slow) var(--ease-out);
    pointer-events: none;
  }

  .cause-card--food::before { background: radial-gradient(ellipse at top left, rgba(74,222,128,0.08) 0%, transparent 55%); }
  .cause-card--foot::before { background: radial-gradient(ellipse at top left, rgba(96,165,250,0.08) 0%, transparent 55%); }
  .cause-card--just::before { background: radial-gradient(ellipse at top left, rgba(192,132,252,0.08) 0%, transparent 55%); }
  .cause-card:hover::before { opacity: 1; }

  .cause-card--food:hover { border-color: rgba(74,222,128,0.35); box-shadow: var(--shadow-food); }
  .cause-card--foot:hover { border-color: rgba(96,165,250,0.35); box-shadow: var(--shadow-foot); }
  .cause-card--just:hover { border-color: rgba(192,132,252,0.35); box-shadow: var(--shadow-just); }
  .cause-card:hover { transform: translateY(-6px); }

  .cause-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    position: relative;
    z-index: 1;
  }

  .cause-card__code {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    font-size: 0.85rem;
    font-weight: 900;
    letter-spacing: 0;
    border: 1px solid currentColor;
  }
  .cause-card__code--food { color: var(--clr-food); background: var(--clr-food-bg); }
  .cause-card__code--foot { color: var(--clr-foot); background: var(--clr-foot-bg); }
  .cause-card__code--just { color: var(--clr-just); background: var(--clr-just-bg); }

  .cause-card__stat {
    padding-block: var(--space-3) 0;
    position: relative;
    z-index: 1;
  }

  .cause-card__stat-number {
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 1;
    margin-bottom: var(--space-2);
  }

  .cause-card--food .cause-card__stat-number { color: var(--clr-food); }
  .cause-card--foot .cause-card__stat-number { color: var(--clr-foot); }
  .cause-card--just .cause-card__stat-number { color: var(--clr-just); }

  .cause-card__stat-label {
    font-size: 0.8125rem;
    color: var(--clr-text-muted);
    max-width: 30ch;
    line-height: 1.45;
  }

  .cause-card__description {
    font-size: 0.9375rem;
    color: var(--clr-text-muted);
    line-height: 1.65;
    flex: 1;
    position: relative;
    z-index: 1;
  }

  .cause-card__actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    position: relative;
    z-index: 2;
  }

  .cause-card__btn {
    font-size: 0.8125rem;
    padding: var(--space-2) var(--space-4);
  }

  .cause-card__arrow { font-weight: 800; }

  .cause-card__overlay-link {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
</style>


