---
// ShareButtons.astro - WhatsApp and Telegram share buttons
interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
const uid = Math.random().toString(36).slice(2, 7);
const encodedTitle = encodeURIComponent(title);
const encodedUrl = encodeURIComponent(url);
const whatsappUrl = `https://wa.me/?text=${encodedTitle}%20${encodedUrl}`;
const telegramUrl = `https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`;
---

<div class="share-buttons" role="group" aria-label="Share this article">
  <a
    href={whatsappUrl}
    class="share-btn share-btn--whatsapp"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Share on WhatsApp (opens in new tab)"
    id="share-whatsapp"
  >
    <svg class="share-btn__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
    </svg>
    Share on WhatsApp
  </a>

  <a
    href={telegramUrl}
    class="share-btn share-btn--telegram"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Share on Telegram (opens in new tab)"
    id="share-telegram"
  >
    <svg class="share-btn__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
    </svg>
    Share on Telegram
  </a>

  <button
    class="share-btn share-btn--copy"
    id={`share-copy-${uid}`}
    type="button"
    aria-label="Copy link to clipboard"
    data-url={url}
  >
    <svg class="share-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
    </svg>
    <span class="copy-label">Copy Link</span>
  </button>
</div>

<script>
  // Use class selector so multiple ShareButtons instances on the same page all work
  document.querySelectorAll<HTMLButtonElement>('.share-btn--copy').forEach(btn => {
    if (btn.dataset.shareInit) return; // guard against double-init
    btn.dataset.shareInit = 'true';
    const copyLabel = btn.querySelector('.copy-label');

    btn.addEventListener('click', async () => {
      const url = btn.dataset.url || window.location.href;
      try {
        await navigator.clipboard.writeText(url);
        if (copyLabel) {
          copyLabel.textContent = 'Copied!';
          btn.style.color = 'var(--clr-success)';
          setTimeout(() => {
            copyLabel.textContent = 'Copy Link';
            btn.style.color = '';
          }, 2000);
        }
      } catch {
        // Fallback for older browsers
        const el = document.createElement('textarea');
        el.value = url;
        document.body.appendChild(el);
        el.select();
        document.execCommand('copy');
        document.body.removeChild(el);
        if (copyLabel) {
          copyLabel.textContent = 'Copied!';
          setTimeout(() => { copyLabel.textContent = 'Copy Link'; }, 2000);
        }
      }
    });
  });
</script>

<style>
  .share-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    border: 1px solid transparent;
    transition: all var(--duration-normal) var(--ease-out);
    background: var(--clr-bg-surface);
  }

  .share-btn__icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .share-btn--whatsapp {
    color: #4ade80;
    border-color: rgba(74,222,128,0.3);
    background: rgba(74,222,128,0.05);
  }
  .share-btn--whatsapp:hover {
    background: rgba(74,222,128,0.12);
    border-color: #4ade80;
    transform: translateY(-2px);
    color: #4ade80;
  }

  .share-btn--telegram {
    color: #60a5fa;
    border-color: rgba(96,165,250,0.3);
    background: rgba(96,165,250,0.05);
  }
  .share-btn--telegram:hover {
    background: rgba(96,165,250,0.12);
    border-color: #60a5fa;
    transform: translateY(-2px);
    color: #60a5fa;
  }

  .share-btn--copy {
    color: var(--clr-text-muted);
    border-color: var(--clr-border);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    background: var(--clr-bg-surface);
  }
  .share-btn--copy:hover {
    color: var(--clr-text);
    border-color: var(--clr-text-muted);
    transform: translateY(-2px);
  }
</style>


